--- /dev/null
+++ b/clang/test/Driver/feos.c
@@ -0,0 +1,146 @@
+// UNSUPPORTED: system-windows
+
+// Compile: header search, relocation model, unwind tables.
+// RUN: %clang -### -c %s --target=x86_64-unknown-feos \
+// RUN:   --sysroot=%S/Inputs/basic_feos_tree \
+// RUN:   -resource-dir=%S/Inputs/resource_dir 2>&1 \
+// RUN:   | FileCheck %s --check-prefixes=CC,CC-X86_64
+// RUN: %clang -### -c %s --target=aarch64-unknown-feos \
+// RUN:   --sysroot=%S/Inputs/basic_feos_tree \
+// RUN:   -resource-dir=%S/Inputs/resource_dir 2>&1 \
+// RUN:   | FileCheck %s --check-prefixes=CC,CC-AARCH64
+// CC-X86_64: "-cc1" "-triple" "x86_64-unknown-feos"
+// CC-AARCH64: "-cc1" "-triple" "aarch64-unknown-feos"
+// CC-X86_64-SAME: "-mrelocation-model" "pic" "-pic-level" "2"
+// CC-AARCH64-SAME: "-mrelocation-model" "static"
+// CC-NOT: "-pic-is-pie"
+// CC-SAME: "-funwind-tables=2"
+// CC-SAME: "-resource-dir" "[[RESOURCE:[^"]+]]"
+// CC-SAME: "-isysroot" "[[SYSROOT:[^"]+]]"
+// CC-SAME: "-internal-isystem" "[[RESOURCE]]{{/|\\\\}}include"
+// CC-SAME: "-internal-externc-isystem" "[[SYSROOT]]{{/|\\\\}}usr{{/|\\\\}}include"
+
+// C++: libc++'s headers in the sysroot.
+// RUN: %clangxx -### -c -x c++ %s --target=x86_64-unknown-feos \
+// RUN:   --sysroot=%S/Inputs/basic_feos_tree \
+// RUN:   -resource-dir=%S/Inputs/resource_dir 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=CXX
+// CXX: "-isysroot" "[[SYSROOT:[^"]+]]"
+// CXX-SAME: "-internal-isystem" "[[SYSROOT]]{{/|\\\\}}usr{{/|\\\\}}include{{/|\\\\}}c++{{/|\\\\}}v1"
+// CXX-SAME: "-internal-externc-isystem" "[[SYSROOT]]{{/|\\\\}}usr{{/|\\\\}}include"
+
+// -nostdinc, -nostdlibinc.
+// RUN: %clang -### -c %s --target=x86_64-unknown-feos -nostdinc \
+// RUN:   --sysroot=%S/Inputs/basic_feos_tree 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=NOSTDINC
+// NOSTDINC-NOT: "-internal-isystem"
+// NOSTDINC-NOT: "-internal-externc-isystem"
+// RUN: %clang -### -c %s --target=x86_64-unknown-feos -nostdlibinc \
+// RUN:   --sysroot=%S/Inputs/basic_feos_tree \
+// RUN:   -resource-dir=%S/Inputs/resource_dir 2>&1 \
+// RUN:   | FileCheck %s --check-prefix=NOSTDLIBINC
+// NOSTDLIBINC: "-internal-isystem" "{{[^"]*}}resource_dir{{/|\\\\}}include"
+// NOSTDLIBINC-NOT: "-internal-externc-isystem"
+
+// Link: a static executable in feos's layout with lld, relibc's crt objects,
