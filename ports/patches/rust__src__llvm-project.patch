diff --git a/clang/lib/Driver/ToolChains/Feos.cpp b/clang/lib/Driver/ToolChains/Feos.cpp
new file mode 100644
index 000000000..9196bf785
--- /dev/null
+++ b/clang/lib/Driver/ToolChains/Feos.cpp
@@ -0,0 +1,208 @@
+//===--- Feos.cpp - feos ToolChain Implementation ---------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "Feos.h"
+#include "clang/Driver/CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/Driver.h"
+#include "clang/Options/Options.h"
+#include "llvm/Option/ArgList.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/VirtualFileSystem.h"
+
+using namespace clang::driver;
+using namespace clang::driver::toolchains;
+using namespace clang;
+using namespace llvm::opt;
+
+void tools::feos::Linker::ConstructJob(Compilation &C, const JobAction &JA,
+                                       const InputInfo &Output,
+                                       const InputInfoList &Inputs,
+                                       const ArgList &Args,
+                                       const char *LinkingOutput) const {
+  const auto &TC = static_cast<const toolchains::Feos &>(getToolChain());
+  const Driver &D = TC.getDriver();
+  ArgStringList CmdArgs;
+
+  // feos loads static executables only, until it has a dynamic loader.
+  if (Arg *A = Args.getLastArg(options::OPT_shared, options::OPT_rdynamic,
+                               options::OPT_static_pie, options::OPT_pie))
+    D.Diag(diag::err_drv_unsupported_opt_for_target)
+        << A->getAsString(Args) << TC.getTripleString();
+
+  const std::string SysRoot = TC.computeSysRoot();
+  if (SysRoot != "/")
+    CmdArgs.push_back(Args.MakeArgString("--sysroot=" + SysRoot));
+
+  // The user layout of docs/feos-abi-v2.md section 7.3: the image at 64 GiB,
+  // each PT_LOAD on pages of its own.
+  CmdArgs.push_back("-static");
+  CmdArgs.push_back("--image-base=0x1000400000");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("separate-loadable-segments");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("max-page-size=4096");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("noexecstack");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("norelro");
+  CmdArgs.push_back("--eh-frame-hdr");
+  if (TC.getArch() == llvm::Triple::aarch64)
+    CmdArgs.push_back("--fix-cortex-a53-843419");
+
+  assert((Output.isFilename() || Output.isNothing()) && "Invalid output.");
+  if (Output.isFilename()) {
+    CmdArgs.push_back("-o");
+    CmdArgs.push_back(Output.getFilename());
+  }
+
+  const bool NoStdLib = Args.hasArg(options::OPT_nostdlib, options::OPT_r);
+  const bool NoStartFiles = NoStdLib || Args.hasArg(options::OPT_nostartfiles);
+  const bool NoDefaultLibs =
+      NoStdLib || Args.hasArg(options::OPT_nodefaultlibs);
+  const bool CompilerRT =
+      TC.GetRuntimeLibType(Args) == ToolChain::RLT_CompilerRT;
+
+  auto AddCrt = [&](StringRef Component, StringRef Fallback) {
+    if (CompilerRT) {
+      std::string P = TC.getCompilerRT(Args, Component, ToolChain::FT_Object);
+      if (TC.getVFS().exists(P)) {
+        CmdArgs.push_back(Args.MakeArgString(P));
+        return;
+      }
+    }
+    if (!Fallback.empty())
+      CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath(Fallback.data())));
+  };
+
+  if (!NoStartFiles) {
+    CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("crt0.o")));
+    CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("crti.o")));
+    AddCrt("crtbegin", "");
+  }
+
+  Args.addAllArgs(CmdArgs, {options::OPT_L, options::OPT_u});
+  TC.AddFilePathLibArgs(Args, CmdArgs);
+
+  if (auto LTO = TC.getLTOMode(Args); LTO != LTOK_None)
+    addLTOOptions(TC, Args, CmdArgs, Output, Inputs, LTO == LTOK_Thin);
+
+  Args.addAllArgs(CmdArgs, {options::OPT_T_Group, options::OPT_s,
+                            options::OPT_t, options::OPT_r});
+
+  AddLinkerInputs(TC, Inputs, Args, CmdArgs, JA);
+
+  if (!NoDefaultLibs) {
+    if (D.CCCIsCXX() && !Args.hasArg(options::OPT_nostdlibxx))
+      TC.AddCXXStdlibLibArgs(Args, CmdArgs);
+    // Archives only: the group lets a linker other than lld resolve the
+    // libc's calls into the runtime and back.
+    CmdArgs.push_back("--start-group");
+    AddRunTimeLibs(TC, D, CmdArgs, Args);
+    if (!Args.hasArg(options::OPT_nolibc))
+      CmdArgs.push_back("-lc");
+    CmdArgs.push_back("--end-group");
+  }
+  Args.ClaimAllArgs(options::OPT_stdlib_EQ);
+  Args.ClaimAllArgs(options::OPT_pthread);
+
+  if (!NoStartFiles) {
+    AddCrt("crtend", "");
+    CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("crtn.o")));
+  }
+
+  const char *Exec = Args.MakeArgString(TC.GetLinkerPath());
+  C.addCommand(std::make_unique<Command>(JA, *this,
+                                         ResponseFileSupport::AtFileCurCP(),
+                                         Exec, CmdArgs, Inputs, Output));
+}
+
+Feos::Feos(const Driver &D, const llvm::Triple &Triple, const ArgList &Args)
+    : ToolChain(D, Triple, Args) {
+  getProgramPaths().push_back(D.Dir);
+  SysRoot = computeSysRoot();
+  if (SysRoot.empty())
+    SysRoot = "/";
+  SmallString<128> Lib(SysRoot);
+  llvm::sys::path::append(Lib, "usr", "lib");
+  getFilePaths().push_back(std::string(Lib));
+}
+
+// --sysroot, else <bin>/../<triple> when the toolchain has one beside it (a
+// cross toolchain), else the root (clang running on feos).
+std::string Feos::computeSysRoot() const {
+  if (!SysRoot.empty())
+    return SysRoot;
+  const Driver &D = getDriver();
+  if (!D.SysRoot.empty())
+    return D.SysRoot;
+  SmallString<128> P(D.Dir);
+  llvm::sys::path::append(P, "..", getTripleString());
+  llvm::sys::path::remove_dots(P, /*remove_dot_dot=*/true);
+  if (getVFS().exists(P))
+    return std::string(P);
+  return std::string();
+}
+
+Tool *Feos::buildLinker() const { return new tools::feos::Linker(*this); }
+
+void Feos::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+                                     ArgStringList &CC1Args) const {
+  const Driver &D = getDriver();
+  if (DriverArgs.hasArg(options::OPT_nostdinc))
+    return;
+
+  if (!DriverArgs.hasArg(options::OPT_nobuiltininc)) {
+    SmallString<128> P(D.ResourceDir);
+    llvm::sys::path::append(P, "include");
+    addSystemInclude(DriverArgs, CC1Args, P);
+  }
+
+  if (DriverArgs.hasArg(options::OPT_nostdlibinc))
+    return;
+
+  SmallString<128> P(computeSysRoot());
+  llvm::sys::path::append(P, "usr", "include");
+  addExternCSystemInclude(DriverArgs, CC1Args, P);
+}
+
+void Feos::AddClangCXXStdlibIncludeArgs(const ArgList &DriverArgs,
+                                        ArgStringList &CC1Args) const {
+  if (DriverArgs.hasArg(options::OPT_nostdinc, options::OPT_nostdlibinc,
+                        options::OPT_nostdincxx))
+    return;
+
+  switch (GetCXXStdlibType(DriverArgs)) {
+  case ToolChain::CST_Libcxx: {
+    SmallString<128> P(computeSysRoot());
+    llvm::sys::path::append(P, "usr", "include", "c++", "v1");
+    addSystemInclude(DriverArgs, CC1Args, P);
+    break;
+  }
+  case ToolChain::CST_Libstdcxx:
+    getDriver().Diag(diag::err_drv_unsupported_opt_for_target)
+        << "-stdlib=libstdc++" << getTripleString();
+    break;
+  }
+}
+
+void Feos::AddCXXStdlibLibArgs(const ArgList &Args,
+                               ArgStringList &CmdArgs) const {
+  switch (GetCXXStdlibType(Args)) {
+  case ToolChain::CST_Libcxx:
+    // Static archives: libc++abi is a library of its own, not linked into
+    // libc++.a, so that Rust programs can share the one libunwind.
+    CmdArgs.push_back("-lc++");
+    if (Args.hasArg(options::OPT_fexperimental_library))
+      CmdArgs.push_back("-lc++experimental");
+    CmdArgs.push_back("-lc++abi");
+    break;
+  case ToolChain::CST_Libstdcxx:
+    break;
+  }
+}
