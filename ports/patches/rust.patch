diff --git a/compiler/rustc_target/src/spec/targets/aarch64_unknown_feos.rs b/compiler/rustc_target/src/spec/targets/aarch64_unknown_feos.rs
new file mode 100644
index 00000000..c51d922c
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/aarch64_unknown_feos.rs
@@ -0,0 +1,29 @@
+use crate::spec::{
+    Arch, Cc, FramePointer, LinkerFlavor, Lld, RelocModel, Target, TargetMetadata, base,
+};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::feos::opts();
+    base.features = "+v8a,+neon,+fp-armv8".into();
+    base.max_atomic_width = Some(128);
+    base.frame_pointer = FramePointer::NonLeaf;
+    // ADRP reaches the image at 64 GiB from static code.
+    base.relocation_model = RelocModel::Static;
+    base.add_pre_link_args(LinkerFlavor::Gnu(Cc::No, Lld::No), &["--fix-cortex-a53-843419"]);
+
+    Target {
+        llvm_target: "aarch64-unknown-feos".into(),
+        metadata: TargetMetadata {
+            description: Some("feos on AArch64, static executables (relibc)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
+                .into(),
+        arch: Arch::AArch64,
+        options: base,
+    }
+}
diff --git a/compiler/rustc_target/src/spec/targets/x86_64_unknown_feos.rs b/compiler/rustc_target/src/spec/targets/x86_64_unknown_feos.rs
new file mode 100644
index 00000000..4b48e1ad
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/x86_64_unknown_feos.rs
@@ -0,0 +1,28 @@
+use crate::spec::{Arch, RelocModel, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::feos::opts();
+    base.cpu = "x86-64".into();
+    // feos keeps CR4.OSXSAVE clear and saves FP state with fxsave.
+    base.features = "+fxsr,+sse,+sse2,-avx,-avx2,-avx512f,-xsave".into();
+    base.plt_by_default = false;
+    base.max_atomic_width = Some(64);
+    // Programs are linked at 64 GiB, beyond the small code model's absolute
+    // addresses: the code is position independent, the executable is not.
+    base.relocation_model = RelocModel::Pic;
+
+    Target {
+        llvm_target: "x86_64-unknown-feos".into(),
+        metadata: TargetMetadata {
+            description: Some("feos on x86_64, static executables (relibc)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128".into(),
+        arch: Arch::X86_64,
+        options: base,
+    }
+}
