+    /// Returns the last status change time of the file, in seconds since Unix Epoch.
+    ///
+    /// # Examples
+    ///
+    #[cfg_attr(target_os = "feos", doc = "```no_run")]
+    #[cfg_attr(not(target_os = "feos"), doc = "```ignore (needs feos)")]
