diff --git a/compiler/rustc_target/src/spec/base/feos.rs b/compiler/rustc_target/src/spec/base/feos.rs
new file mode 100644
index 00000000..302e0c70
--- /dev/null
+++ b/compiler/rustc_target/src/spec/base/feos.rs
@@ -0,0 +1,56 @@
+use crate::spec::{
+    Cc, LinkOutputKind, LinkerFlavor, Lld, Os, PanicStrategy, RelroLevel, StackProbeType,
+    TargetOptions, crt_objects, cvs,
+};
+
+/// feos: static executables over relibc, linked by rust-lld in feos's user layout
+/// (the image at 64 GiB, every `PT_LOAD` on pages of its own).
+pub(crate) fn opts() -> TargetOptions {
+    // (Given for `ld`; `link_args` adds them for its `rust-lld` twin too.)
+    let pre_link_args = TargetOptions::link_args(
+        LinkerFlavor::Gnu(Cc::No, Lld::No),
+        &[
+            "-static",
+            "--image-base=0x1000400000",
+            "-z",
+            "separate-loadable-segments",
+            "-z",
+            "max-page-size=4096",
+            "-z",
+            "noexecstack",
+        ],
+    );
+    // relibc's `libc.a` holds renamed copies of compiler-builtins' symbols, so the C
+    // parts of a program need a `libcompiler_builtins.a` of their own.
+    let late_link_args = TargetOptions::link_args(
+        LinkerFlavor::Gnu(Cc::No, Lld::No),
+        &["-lc", "-lm", "-lcompiler_builtins"],
+    );
+
+    TargetOptions {
+        os: Os::Feos,
+        families: cvs!["unix"],
+        linker_flavor: LinkerFlavor::Gnu(Cc::No, Lld::Yes),
+        linker: Some("rust-lld".into()),
+        pre_link_args,
+        late_link_args,
+        pre_link_objects: crt_objects::new(&[(
+            LinkOutputKind::StaticNoPicExe,
+            &["crt0.o", "crti.o"],
+        )]),
+        post_link_objects: crt_objects::new(&[(LinkOutputKind::StaticNoPicExe, &["crtn.o"])]),
+        // Static executables only until the kernel loads dynamic programs.
+        dynamic_linking: false,
+        position_independent_executables: false,
+        static_position_independent_executables: false,
+        crt_static_default: true,
+        crt_static_respected: true,
+        has_rpath: false,
+        has_thread_local: true,
+        relro_level: RelroLevel::Off,
+        panic_strategy: PanicStrategy::Unwind,
+        default_uwtable: true,
+        stack_probes: StackProbeType::Inline,
+        ..Default::default()
+    }
+}
