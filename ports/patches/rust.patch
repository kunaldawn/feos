diff --git a/library/std/src/sys/random/feos.rs b/library/std/src/sys/random/feos.rs
new file mode 100644
index 00000000..05752dcd
--- /dev/null
+++ b/library/std/src/sys/random/feos.rs
@@ -0,0 +1,98 @@
+//! Random data on feos (`docs/feos-abi-v2.md` 10.2): the kernel's CSPRNG through
+//! relibc's `getrandom` (`GETRANDOM`, kernel stage 1e.1), as Linux's arm uses it:
+//! `GRND_INSECURE` for `HashMap`'s keys, so they never wait for seeding, and plain
+//! `getrandom` for `fill_bytes`.
+//!
+//! Kernels before stage 1e.1 answer `ENOSYS` and have no `/dev/urandom`. There:
+//! - `hashmap_random_keys` takes the 16 bytes the kernel puts at `AT_RANDOM` in every
+//!   program's aux vector (section 7.2), mixed with the monotonic and wall clocks and a
+//!   per-call counter, so every `HashMap` of a process gets different keys;
+//! - `fill_bytes` reads `/dev/urandom` if there is one, and otherwise panics: nothing
+//!   that claims to be random is made up.
+
+use crate::fs::File;
+use crate::io::Read;
+use crate::sync::OnceLock;
+use crate::sync::atomic::Ordering::Relaxed;
+use crate::sync::atomic::{Atomic, AtomicBool, AtomicU64};
+use crate::sys::io::errno;
+
+static GETRANDOM_AVAILABLE: Atomic<bool> = AtomicBool::new(true);
+
+/// Fills `bytes` from `GETRANDOM`; false if the kernel has no `GETRANDOM`.
+fn getrandom(mut bytes: &mut [u8], flags: libc::c_uint) -> bool {
+    if !GETRANDOM_AVAILABLE.load(Relaxed) {
+        return false;
+    }
+    while !bytes.is_empty() {
+        let ret = unsafe { libc::getrandom(bytes.as_mut_ptr().cast(), bytes.len(), flags) };
+        if ret >= 0 {
+            bytes = &mut bytes[ret as usize..];
+        } else {
+            match errno() {
+                libc::EINTR => continue,
+                libc::ENOSYS => {
+                    GETRANDOM_AVAILABLE.store(false, Relaxed);
+                    return false;
+                }
+                other => panic!("failed to generate random data: errno={other}, flags={flags}"),
+            }
+        }
+    }
+    true
+}
+
+pub fn fill_bytes(bytes: &mut [u8]) {
+    if getrandom(bytes, 0) {
+        return;
+    }
+    static DEVICE: OnceLock<File> = OnceLock::new();
+    DEVICE
+        .get_or_try_init(|| File::open("/dev/urandom"))
+        .and_then(|mut dev| dev.read_exact(bytes))
+        .expect("no randomness source: the feos kernel has no GETRANDOM or /dev/urandom yet (stage 1e.1)");
+}
+
+pub fn hashmap_random_keys() -> (u64, u64) {
+    let mut bytes = [0; 16];
+    if !getrandom(&mut bytes, libc::GRND_INSECURE) {
+        bytes = fallback_keys();
+    }
+    let k1 = u64::from_ne_bytes(bytes[..8].try_into().unwrap());
+    let k2 = u64::from_ne_bytes(bytes[8..].try_into().unwrap());
+    (k1, k2)
+}
+
+/// `AT_RANDOM`'s bytes, the clocks and a counter, mixed (SplitMix64's finaliser, the
+/// mixing step, not a generator): `HashMap`'s DoS resistance rests on `AT_RANDOM`.
+fn fallback_keys() -> [u8; 16] {
+    static COUNTER: Atomic<u64> = AtomicU64::new(0);
+
+    fn mix(mut z: u64) -> u64 {
+        z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);
+        z ^ (z >> 31)
+    }
+    fn clock(id: libc::clockid_t) -> u64 {
+        let mut t = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+        unsafe { libc::clock_gettime(id, &mut t) };
+        (t.tv_sec as u64).wrapping_mul(1_000_000_000).wrapping_add(t.tv_nsec as u64)
+    }
+
+    let mut seed = [0u64; 2];
+    let at_random =
+        crate::ptr::with_exposed_provenance::<u8>(unsafe { libc::getauxval(libc::AT_RANDOM) } as usize);
+    if !at_random.is_null() {
+        let mut raw = [0u8; 16];
+        unsafe { crate::ptr::copy_nonoverlapping(at_random, raw.as_mut_ptr(), 16) };
+        seed[0] = u64::from_ne_bytes(raw[..8].try_into().unwrap());
+        seed[1] = u64::from_ne_bytes(raw[8..].try_into().unwrap());
+    }
+    let n = COUNTER.fetch_add(1, Relaxed);
+    let k1 = mix(seed[0] ^ mix(clock(libc::CLOCK_MONOTONIC) ^ n));
+    let k2 = mix(seed[1] ^ mix(clock(libc::CLOCK_REALTIME).wrapping_add(n.rotate_left(32))));
+    let mut out = [0u8; 16];
+    out[..8].copy_from_slice(&k1.to_ne_bytes());
+    out[8..].copy_from_slice(&k2.to_ne_bytes());
+    out
+}
