+//! feos: the monolithic kernel of <https://github.com/kunaldawn/feos>, with relibc as its
+//! C library.
+//!
+//! Every type, structure and constant here is the one relibc's feos headers declare
+//! (feos takes Linux's numbers and most of its layouts, `docs/feos-abi-v2.md` section 5;
+//! relibc's own structures where relibc's headers have them, such as `stat`, `sigset_t`
+//! and the pthread types). `POSIX_SPAWN_*` are glibc's bit values. The constants were
+//! generated from relibc's headers and the whole module is checked against them, for
+//! both architectures, by feos's `ports/test/libc-check` (sizes, alignments, field
+//! offsets and sizes, constant values, and that every function is in relibc's `libc.a`).
+
+use crate::prelude::*;
+
+cfg_if! {
+    if #[cfg(target_arch = "aarch64")] {
+        pub type wchar_t = u32;
+    } else {
+        pub type wchar_t = i32;
+    }
+}
