+impl siginfo_t {
+    pub unsafe fn si_addr(&self) -> *mut c_void {
+        #[repr(C)]
+        struct siginfo_sigfault {
+            _si_signo: c_int,
+            _si_errno: c_int,
+            _si_code: c_int,
+            _pad: c_int,
+            si_addr: *mut c_void,
+        }
+        (*(self as *const siginfo_t as *const siginfo_sigfault)).si_addr
+    }
+
+    pub unsafe fn si_pid(&self) -> crate::pid_t {
+        (*self.common()).si_pid
+    }
+
+    pub unsafe fn si_uid(&self) -> crate::uid_t {
+        (*self.common()).si_uid
+    }
+
+    pub unsafe fn si_value(&self) -> crate::sigval {
+        (*self.common()).si_value
+    }
+
+    unsafe fn common(&self) -> *const siginfo_common {
+        self as *const siginfo_t as *const siginfo_common
+    }
+}
+
+#[repr(C)]
+struct siginfo_common {
