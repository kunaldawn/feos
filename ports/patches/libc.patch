+/// `ioctl`'s request type. relibc declares `int ioctl(int, unsigned long, void *)`; the
+/// function is declared variadic here, as on Linux, which passes the same registers on
+/// both architectures and keeps Linux callers (`ioctl(fd, FIONBIO, &mut on)`) building.
+pub type Ioctl = c_ulong;
