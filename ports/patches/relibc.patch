+    fn getrlimit(resource: c_int, mut rlim: Out<rlimit>) -> Result<()> {
+        use crate::header::sys_resource::*;
+        let info = sysinfo()?;
+        let limit = match resource {
+            RLIMIT_NOFILE => info.fd_max as rlim_t,
+            // The main stack is 8 MiB and doesn't grow (section 6).
+            RLIMIT_STACK => abi::USER_STACK_SIZE as rlim_t,
+            RLIMIT_AS | RLIMIT_DATA => info.memory_limit as rlim_t,
+            RLIMIT_NPROC => info.task_max as rlim_t,
+            RLIMIT_CORE => 0,
+            r if (0..RLIMIT_NLIMITS).contains(&r) => RLIM_INFINITY,
+            _ => return Err(Errno(EINVAL)),
+        };
+        rlim.write(rlimit {
+            rlim_cur: limit,
+            rlim_max: limit,
+        });
+        Ok(())
+    }
