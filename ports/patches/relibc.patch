+//! No `epoll` on feos (section 9.4 of `docs/feos-abi-v2.md`): `select` is built on
+//! `POLL` instead, and nothing on the toolchain's path needs epoll.
+
+use super::Sys;
+use crate::{
+    error::{Errno, Result},
+    header::{bits_sigset_t::sigset_t, errno::ENOSYS, sys_epoll::epoll_event},
+    platform::{PalEpoll, types::c_int},
+};
+
+impl PalEpoll for Sys {
+    fn epoll_create1(_flags: c_int) -> Result<c_int> {
+        Err(Errno(ENOSYS))
+    }
+
+    fn epoll_ctl(_epfd: c_int, _op: c_int, _fd: c_int, _event: Option<&mut epoll_event>) -> Result<()> {
+        Err(Errno(ENOSYS))
+    }
+
+    fn epoll_pwait(
+        _epfd: c_int,
+        _events: &mut [epoll_event],
+        _timeout: c_int,
+        _sigmask: Option<&sigset_t>,
+    ) -> Result<usize> {
+        Err(Errno(ENOSYS))
+    }
+}
diff --git a/src/platform/feos/mod.rs b/src/platform/feos/mod.rs
new file mode 100644
index 0000000..3749074
--- /dev/null
+++ b/src/platform/feos/mod.rs
@@ -0,0 +1,1398 @@
+//! The feos platform: relibc's [`Pal`] over the feos kernel interface, each function
+//! as section 9 of `docs/feos-abi-v2.md` maps it.
+//!
+//! Every call number, structure and feos-only constant is in [`abi`]. Calls the
+//! kernel doesn't have yet (they return `ENOSYS` until their stage lands) are made all
+//! the same, at their numbers, and their answer passed on: nothing here fakes a result.
+
+use alloc::{boxed::Box, vec::Vec};
+use core::{
+    arch::global_asm,
+    mem::{self, size_of},
+    num::NonZeroU64,
+    ptr,
+};
+
+use super::{Pal, types::*};
+use crate::{
+    c_str::CStr,
+    error::{Errno, Result},
+    header::{
+        bits_sigset_t::sigset_t,
+        dirent::dirent,
+        errno::{EINVAL, EIO, ENOMEM, ENOSYS, EPERM, ERANGE},
+        fcntl::{AT_EMPTY_PATH, AT_FDCWD, O_CLOEXEC, O_CREAT, O_DIRECTORY, O_EXCL, O_PATH, O_WRONLY},
+        poll::pollfd,
+        signal::sigevent,
+        sys_resource::{rlimit, rusage},
+        sys_select::timeval,
+        sys_stat::{S_IFMT, S_IFREG, stat},
+        sys_statvfs::statvfs,
+        sys_time::timezone,
+        sys_uio::iovec,
+        sys_utsname::{UTSLENGTH, utsname},
+        time::{itimerspec, timespec},
+        unistd::{SEEK_CUR, SEEK_SET},
+    },
+    iter::NulTerminated,
+    ld_so::tcb::OsSpecific,
+    out::Out,
+};
+
+pub mod abi;
+mod checks;
+mod epoll;
+mod ptrace;
+mod signal;
+mod socket;
+pub mod syscall;
+
+use self::syscall::*;
+use abi::nr;
+
+/// The largest negated error number a call returns.
+const ERRNO_MAX: usize = 4095;
+
+/// A raw result as a [`Result`]: `-4095..0` is a negated error number.
+#[inline]
+pub fn e_raw(sys: usize) -> Result<usize> {
+    if sys > ERRNO_MAX.wrapping_neg() {
+        Err(Errno(sys.wrapping_neg() as c_int))
+    } else {
+        Ok(sys)
+    }
+}
+
+/// A C string as feos takes paths: pointer and length, no NUL.
+#[inline]
+fn path(p: CStr) -> (usize, usize) {
+    (p.as_ptr() as usize, p.len())
+}
+
+/// A 32-bit C argument as a register: sign extended, as section 1 asks of a C caller's
+/// `-1`.
+#[inline]
+fn int(value: c_int) -> usize {
+    value as isize as usize
+}
+
+fn path_at(dirfd: c_int, p: CStr) -> abi::PathAt {
+    abi::PathAt {
+        dirfd,
+        reserved: 0,
+        pointer: p.as_ptr() as u64,
+        length: p.len() as u64,
+    }
+}
+
+/// A NUL-terminated array of C strings as `UserStr`s.
+unsafe fn user_strs<'a>(strings: impl Iterator<Item = &'a *mut c_char>) -> Vec<abi::UserStr> {
+    strings
+        .map(|&s| {
+            let s = unsafe { CStr::from_ptr(s) };
+            abi::UserStr {
+                pointer: s.as_ptr() as usize,
+                length: s.len(),
+            }
+        })
+        .collect()
+}
+
+/// The kernel's [`abi::SysInfo`].
+pub fn sysinfo() -> Result<abi::SysInfo> {
+    let mut info = abi::SysInfo::zeroed();
+    e_raw(unsafe {
+        syscall2(
+            nr::SYSINFO,
+            (&raw mut info) as usize,
+            size_of::<abi::SysInfo>(),
+        )
+    })?;
+    Ok(info)
+}
+
+/// The aux vector, kept at start for `getauxval` (section 7.2).
+static mut AUXV: Option<Box<[[usize; 2]]>> = None;
+
+/// Keeps the aux vector `relibc_start` collected (sorted by type).
+///
+/// Safety: only while one thread exists.
+pub unsafe fn init(auxvs: Box<[[usize; 2]]>) {
+    unsafe { *(&raw mut AUXV) = Some(auxvs) };
+}
+
+/// `getauxval(type)`: its value, or `None` if the vector has no such entry.
+pub fn getauxval(kind: usize) -> Option<usize> {
+    let auxvs = unsafe { (*(&raw const AUXV)).as_deref()? };
+    super::get_auxv(auxvs, kind)
+}
+
+/// `sysconf` values that come from the kernel ([`abi::SysInfo`]), or `None` for those
+/// relibc's Linux table answers.
+pub fn sysconf(name: c_int) -> Option<c_long> {
+    use crate::header::unistd::*;
+    let info = || sysinfo().ok();
+    Some(match name {
+        _SC_NPROCESSORS_ONLN => info()?.cpus_online as c_long,
+        _SC_NPROCESSORS_CONF => info()?.cpus_configured as c_long,
+        _SC_PHYS_PAGES => info()?.total_pages as c_long,
+        _SC_AVPHYS_PAGES => info()?.free_pages as c_long,
+        _SC_ARG_MAX => info()?.arg_max as c_long,
+        _SC_OPEN_MAX => info()?.fd_max as c_long,
+        _SC_CHILD_MAX => info()?.task_max as c_long,
+        _SC_PAGESIZE => abi::PAGE_SIZE as c_long,
+        _SC_MINSIGSTKSZ => getauxval(abi::aux::MINSIGSTKSZ).unwrap_or(2048) as c_long,
+        _SC_SIGSTKSZ => 8192,
+        _ => return None,
+    })
+}
+
+/// The C-side `ioctl` for feos: the terminal requests relibc's headers name (Linux's
+/// numbers) translated to feos's own, `FIONBIO`/`FIOCLEX`/`FIONCLEX` through `FCNTL`
+/// (section 10.1). Anything else is `EINVAL`.
+pub unsafe fn ioctl(fd: c_int, request: c_ulong, arg: *mut c_void) -> Result<c_int> {
+    use crate::header::sys_ioctl::*;
+    use abi::ioctl as r;
+    let call = |request: usize, arg: usize| -> Result<c_int> {
+        e_raw(unsafe { syscall3(nr::IOCTL, int(fd), request, arg) }).map(|v| v as c_int)
+    };
+    let a = arg as usize;
+    match request {
+        TCGETS => call(r::TTY_GET_ATTR, a),
+        TCSETS => call(r::TTY_SET_ATTR, a),
+        TCSETSW => call(r::TTY_SET_ATTR_DRAIN, a),
+        TCSETSF => call(r::TTY_SET_ATTR_FLUSH, a),
+        TIOCGWINSZ => call(r::TTY_GET_WINSIZE, a),
+        TIOCSWINSZ => call(r::TTY_SET_WINSIZE, a),
+        TIOCGPGRP => call(r::TTY_GET_PGRP, a),
+        TIOCSPGRP => call(r::TTY_SET_PGRP, a),
+        FIONREAD => call(r::FD_NREAD, a),
+        // tcdrain is TCSBRK with a non-zero argument; a zero one would send a break,
+        // which the console has no use for.
+        TCSBRK => call(r::TTY_DRAIN, 0),
+        TCFLSH => call(r::TTY_FLUSH, a),
+        TCXONC => call(r::TTY_FLOW, a),
+        TIOCGSID => call(r::TTY_GET_SID, a),
+        // No controlling-terminal acquisition: 0 on a terminal, ENOTTY otherwise.
+        TIOCSCTTY | TIOCNOTTY => {
+            let mut size = abi::WinSize::default();
+            call(r::TTY_GET_WINSIZE, (&raw mut size) as usize).map(|_| 0)
+        }
+        FIONBIO => {
+            let on = unsafe { *arg.cast::<c_int>() } != 0;
+            let flags = Sys::fcntl(fd, abi::f::GETFL, 0)?;
+            let flags = if on {
+                flags | abi::o::NONBLOCK
+            } else {
+                flags & !abi::o::NONBLOCK
+            };
+            Sys::fcntl(fd, abi::f::SETFL, flags as c_ulonglong).map(|_| 0)
+        }
+        FIOCLEX => Sys::fcntl(fd, abi::f::SETFD, abi::f::FD_CLOEXEC as c_ulonglong).map(|_| 0),
+        FIONCLEX => Sys::fcntl(fd, abi::f::SETFD, 0).map(|_| 0),
+        _ => Err(Errno(EINVAL)),
+    }
+}
+
+fn stat_from(s: &abi::Stat2) -> stat {
+    stat {
+        st_dev: s.dev as dev_t,
+        st_ino: s.ino as ino_t,
+        st_nlink: s.nlink as nlink_t,
+        st_mode: s.mode as mode_t,
+        st_uid: s.uid as uid_t,
+        st_gid: s.gid as gid_t,
+        st_rdev: s.rdev as dev_t,
+        st_size: s.size as off_t,
+        st_blksize: s.blksize as blksize_t,
+        st_blocks: s.blocks as blkcnt_t,
+        st_atim: timespec {
+            tv_sec: s.atime.sec as time_t,
+            tv_nsec: s.atime.nsec as c_long,
+        },
+        st_mtim: timespec {
+            tv_sec: s.mtime.sec as time_t,
+            tv_nsec: s.mtime.nsec as c_long,
+        },
+        st_ctim: timespec {
+            tv_sec: s.ctime.sec as time_t,
+            tv_nsec: s.ctime.nsec as c_long,
+        },
+        _pad: [0; 24],
+    }
+}
+
+// The thread trampoline `THREAD_CREATE` starts a pthread at. relibc's `create` pushes
+// its start words (entry, then its five arguments) below the top of the new stack;
+// `rlct_clone` passes their address as the thread's argument and a 16-byte aligned
+// stack top below them, so the new thread points its stack at the words, pops them
+// as the Linux backend's `clone` path does, and calls the entry. The entry never
+// returns (it ends with `exit_thread`).
+#[cfg(target_arch = "x86_64")]
+global_asm!(
+    "
+    .globl __relibc_feos_thread_start
+    .type __relibc_feos_thread_start, @function
+__relibc_feos_thread_start:
+    mov rsp, rdi
+    pop rax
+    pop rdi
+    pop rsi
+    pop rdx
+    pop rcx
+    pop r8
+    pop r9
+    call rax
+    ud2
+    .size __relibc_feos_thread_start, . - __relibc_feos_thread_start
+"
+);
+
+#[cfg(target_arch = "aarch64")]
+global_asm!(
+    "
+    .globl __relibc_feos_thread_start
+    .type __relibc_feos_thread_start, @function
+__relibc_feos_thread_start:
+    mov sp, x0
+    ldp x8, x0, [sp], #16
+    ldp x1, x2, [sp], #16
+    ldp x3, x4, [sp], #16
+    ldr x5, [sp], #16
+    blr x8
+    brk #0
+    .size __relibc_feos_thread_start, . - __relibc_feos_thread_start
+"
+);
+
+unsafe extern "C" {
+    fn __relibc_feos_thread_start();
+}
+
+/// feos implementation of [`Pal`].
+pub struct Sys;
+
+impl Sys {
+    /// The C `ioctl`'s backend: see [`ioctl`].
+    pub unsafe fn ioctl(fd: c_int, request: c_ulong, out: *mut c_void) -> Result<c_int> {
+        unsafe { ioctl(fd, request, out) }
+    }
+
+    /// `THREAD_KILL`, `raise`'s and `pthread_kill`'s call.
+    fn thread_kill(tid: usize, signal: c_int) -> Result<()> {
+        e_raw(unsafe { syscall2(nr::THREAD_KILL, tid, int(signal)) }).map(|_| ())
+    }
+
+    /// `SET_TLS`: the TLS register, `FS_BASE` or `TPIDR_EL0`.
+    pub unsafe fn set_tls(value: usize) -> Result<()> {
+        e_raw(unsafe { syscall1(nr::SET_TLS, value) }).map(|_| ())
+    }
+
+    unsafe fn exec(request: &abi::ExecRequest) -> Result<()> {
+        e_raw(unsafe { syscall1(nr::EXEC, ptr::from_ref(request) as usize) })?;
+        unreachable!("EXEC returned success")
+    }
+
+    unsafe fn exec_strings(
+        path: abi::PathAt,
+        flags: u64,
+        argv: *const *mut c_char,
+        envp: *const *mut c_char,
+    ) -> Result<()> {
+        let args = match unsafe { NulTerminated::new(argv) } {
+            Some(argv) => unsafe { user_strs(argv) },
+            None => Vec::new(),
+        };
+        let envs = match unsafe { NulTerminated::new(envp) } {
+            Some(envp) => unsafe { user_strs(envp) },
+            None => Vec::new(),
+        };
+        let request = abi::ExecRequest {
+            path,
+            argv: args.as_ptr() as u64,
+            argc: args.len() as u64,
+            envp: envs.as_ptr() as u64,
+            envc: envs.len() as u64,
+            flags,
+            reserved: [0; 2],
+        };
+        unsafe { Self::exec(&request) }
+    }
+
+    /// v1 `WAIT`'s answer for a child, as a POSIX status: the exit code it reports
+    /// (`128 + signal` for a child a signal ended, 139 for a fault) is encoded as an
+    /// exit with that code, since v1 can't tell the two apart.
+    fn wait_v1(pid: pid_t) -> Result<c_int> {
+        let status = e_raw(unsafe { syscall1(nr::WAIT, int(pid)) })?;
+        Ok(((status & 0xff) << 8) as c_int)
+    }
+}
+
+impl Pal for Sys {
+    fn faccessat(fd: c_int, p: CStr, amode: c_int, flags: c_int) -> Result<()> {
+        let (p, len) = path(p);
+        e_raw(unsafe { syscall5(nr::FACCESSAT, int(fd), p, len, int(amode), int(flags)) })
+            .map(|_| ())
+    }
+
+    unsafe fn brk(_addr: *mut c_void) -> Result<*mut c_void> {
+        // No brk on feos: everything allocates with mmap (section 9.1).
+        Err(Errno(ENOMEM))
+    }
+
+    fn chdir(p: CStr) -> Result<()> {
+        let fd = Self::openat(AT_FDCWD, p, O_PATH | O_DIRECTORY | O_CLOEXEC, 0)?;
+        let result = Self::fchdir(fd);
+        let _ = Self::close(fd);
+        result
+    }
+
+    fn fchownat(fildes: c_int, p: CStr, owner: uid_t, group: gid_t, flags: c_int) -> Result<()> {
+        let (p, len) = path(p);
+        e_raw(unsafe {
+            syscall6(
+                nr::FCHOWNAT,
+                int(fildes),
+                p,
+                len,
+                int(owner),
+                int(group),
+                int(flags),
+            )
+        })
+        .map(|_| ())
+    }
+
+    fn clock_getres(clk_id: clockid_t, res: Option<Out<timespec>>) -> Result<()> {
+        let out = res.map_or(0, |mut p| p.as_mut_ptr() as usize);
+        e_raw(unsafe { syscall2(nr::CLOCK_GETRES, int(clk_id), out) }).map(|_| ())
+    }
+
+    fn clock_gettime(clk_id: clockid_t, mut tp: Out<timespec>) -> Result<()> {
+        e_raw(unsafe { syscall2(nr::CLOCK_GETTIME, int(clk_id), tp.as_mut_ptr() as usize) })
+            .map(|_| ())
+    }
+
+    unsafe fn clock_settime(clk_id: clockid_t, tp: *const timespec) -> Result<()> {
+        e_raw(unsafe { syscall2(nr::CLOCK_SETTIME, int(clk_id), tp as usize) }).map(|_| ())
+    }
+
+    fn close(fildes: c_int) -> Result<()> {
+        e_raw(unsafe { syscall1(nr::CLOSE, int(fildes)) }).map(|_| ())
+    }
+
+    fn dup2(fildes: c_int, fildes2: c_int) -> Result<c_int> {
+        if fildes == fildes2 {
+            // DUP3 refuses equal descriptors; dup2 returns the one, if it's open.
+            Self::fcntl(fildes, abi::f::GETFD, 0)?;
+            return Ok(fildes);
+        }
+        e_raw(unsafe { syscall3(nr::DUP3, int(fildes), int(fildes2), 0) }).map(|f| f as c_int)
+    }
+
+    unsafe fn execve(p: CStr, argv: *const *mut c_char, envp: *const *mut c_char) -> Result<()> {
+        unsafe { Self::exec_strings(path_at(AT_FDCWD, p), 0, argv, envp) }
+    }
+
+    unsafe fn fexecve(
+        fildes: c_int,
+        argv: *const *mut c_char,
+        envp: *const *mut c_char,
+    ) -> Result<()> {
+        let at = abi::PathAt {
+            dirfd: fildes,
+            reserved: 0,
+            pointer: 0,
+            length: 0,
+        };
+        unsafe { Self::exec_strings(at, abi::spawn::EMPTY_PATH, argv, envp) }
+    }
+
+    fn exit(status: c_int) -> ! {
+        unsafe { syscall1(nr::EXIT, int(status)) };
+        unreachable!("EXIT returned");
+    }
+
+    unsafe fn exit_thread(stack_base: *mut (), stack_size: usize) -> ! {
+        // The kernel unmaps the stack once the thread is off it. A range it won't take
+        // is EINVAL and the call returns; then end without unmapping.
+        unsafe { syscall2(nr::THREAD_EXIT, stack_base as usize, stack_size) };
+        unsafe { syscall2(nr::THREAD_EXIT, 0, 0) };
+        unreachable!("THREAD_EXIT returned");
+    }
+
+    fn fchdir(fildes: c_int) -> Result<()> {
+        e_raw(unsafe { syscall1(nr::FCHDIR, int(fildes)) }).map(|_| ())
+    }
+
+    fn fchmodat(dirfd: c_int, p: Option<CStr>, mode: mode_t, mut flags: c_int) -> Result<()> {
+        let (p, len) = match p {
+            Some(p) => path(p),
+            None => {
+                flags |= AT_EMPTY_PATH;
+                (0, 0)
+            }
+        };
+        e_raw(unsafe {
+            syscall5(nr::FCHMODAT, int(dirfd), p, len, mode as usize, int(flags))
+        })
+        .map(|_| ())
+    }
+
+    fn fdatasync(fildes: c_int) -> Result<()> {
+        e_raw(unsafe { syscall2(nr::FSYNC, int(fildes), abi::FSYNC_DATA) }).map(|_| ())
+    }
+
+    fn flock(fd: c_int, operation: c_int) -> Result<()> {
+        e_raw(unsafe { syscall2(nr::FLOCK, int(fd), int(operation)) }).map(|_| ())
+    }
+
+    fn fstatat(fildes: c_int, p: Option<CStr>, mut buf: Out<stat>, mut flags: c_int) -> Result<()> {
+        let (p, len) = match p {
+            Some(p) => path(p),
+            None => {
+                flags |= AT_EMPTY_PATH;
+                (0, 0)
+            }
+        };
+        let mut st = abi::Stat2::default();
+        e_raw(unsafe {
+            syscall5(
+                nr::FSTATAT,
+                int(fildes),
+                p,
+                len,
+                (&raw mut st) as usize,
+                int(flags),
+            )
+        })?;
+        buf.write(stat_from(&st));
+        Ok(())
+    }
+
+    fn fstatvfs(fildes: c_int, mut buf: Out<statvfs>) -> Result<()> {
+        let mut s = abi::StatVfs::default();
+        e_raw(unsafe { syscall2(nr::FSTATVFS, int(fildes), (&raw mut s) as usize) })?;
+        buf.write(statvfs {
+            f_bsize: s.bsize as c_ulong,
+            f_frsize: s.frsize as c_ulong,
+            f_blocks: s.blocks as fsblkcnt_t,
+            f_bfree: s.bfree as fsblkcnt_t,
+            f_bavail: s.bavail as fsblkcnt_t,
+            f_files: s.files as fsfilcnt_t,
+            f_ffree: s.ffree as fsfilcnt_t,
+            f_favail: s.favail as fsfilcnt_t,
+            f_fsid: s.fsid as c_ulong,
+            f_flag: s.flags as c_ulong,
+            f_namemax: s.namemax as c_ulong,
+        });
+        Ok(())
+    }
+
+    fn fcntl(fildes: c_int, cmd: c_int, arg: c_ulonglong) -> Result<c_int> {
+        // Lock commands take a pointer to relibc's `struct flock`, which is Linux's
+        // and so `abi::Flock`; the rest a 32-bit argument.
+        let arg = match cmd {
+            abi::f::GETLK | abi::f::SETLK | abi::f::SETLKW => arg as usize,
+            _ => int(arg as c_int),
+        };
