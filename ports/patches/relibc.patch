+    unsafe fn readv(fildes: c_int, iov: *const iovec, iovcnt: c_int) -> Result<usize> {
+        // One READ per buffer, stopping at a short read.
+        if iovcnt < 0 {
+            return Err(Errno(EINVAL));
+        }
+        let iovs = unsafe { core::slice::from_raw_parts(iov, iovcnt as usize) };
+        let mut total = 0usize;
+        for v in iovs {
+            if v.iov_len == 0 {
+                continue;
+            }
+            let buf = unsafe { core::slice::from_raw_parts_mut(v.iov_base.cast::<u8>(), v.iov_len) };
+            match Self::read(fildes, buf) {
+                Ok(n) => {
+                    total += n;
+                    if n < v.iov_len {
+                        break;
+                    }
+                }
+                Err(e) if total == 0 => return Err(e),
+                Err(_) => break,
+            }
+        }
+        Ok(total)
+    }
