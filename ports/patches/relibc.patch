+//! The raw feos system call (section 1 of `docs/feos-abi-v2.md`).
+//!
+//! x86_64: `int $0xf0`, the number in `rax`, arguments in `rdi`, `rsi`, `rdx`, `r10`,
+//! `r8`, `r9`, the result in `rax`. AArch64: `svc #0`, the number in `x8`, arguments in
+//! `x0`..`x5`, the result in `x0`. Every other register survives the call, but the
+//! condition flags don't, so none of these say `preserves_flags`. A result in
+//! `-4095..0` is a negated error number.
+//!
+//! Safety, for every function here: the arguments must be what call `n` takes, and the
+//! pointers among them valid for what the call does with them.
+
+use core::arch::asm;
+
+#[cfg(target_arch = "x86_64")]
+mod imp {
+    use super::asm;
+
+    #[inline(always)]
+    pub unsafe fn syscall0(n: usize) -> usize {
+        let ret;
+        unsafe { asm!("int 0xf0", inlateout("rax") n => ret, options(nostack)) };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall1(n: usize, a: usize) -> usize {
+        let ret;
+        unsafe { asm!("int 0xf0", inlateout("rax") n => ret, in("rdi") a, options(nostack)) };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall2(n: usize, a: usize, b: usize) -> usize {
+        let ret;
+        unsafe {
+            asm!("int 0xf0", inlateout("rax") n => ret, in("rdi") a, in("rsi") b, options(nostack))
+        };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall3(n: usize, a: usize, b: usize, c: usize) -> usize {
+        let ret;
+        unsafe {
+            asm!("int 0xf0", inlateout("rax") n => ret, in("rdi") a, in("rsi") b, in("rdx") c,
+                options(nostack))
+        };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall4(n: usize, a: usize, b: usize, c: usize, d: usize) -> usize {
+        let ret;
+        unsafe {
+            asm!("int 0xf0", inlateout("rax") n => ret, in("rdi") a, in("rsi") b, in("rdx") c,
+                in("r10") d, options(nostack))
+        };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall5(n: usize, a: usize, b: usize, c: usize, d: usize, e: usize) -> usize {
+        let ret;
+        unsafe {
+            asm!("int 0xf0", inlateout("rax") n => ret, in("rdi") a, in("rsi") b, in("rdx") c,
+                in("r10") d, in("r8") e, options(nostack))
+        };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall6(
+        n: usize,
+        a: usize,
+        b: usize,
+        c: usize,
+        d: usize,
+        e: usize,
+        f: usize,
+    ) -> usize {
+        let ret;
+        unsafe {
+            asm!("int 0xf0", inlateout("rax") n => ret, in("rdi") a, in("rsi") b, in("rdx") c,
+                in("r10") d, in("r8") e, in("r9") f, options(nostack))
+        };
+        ret
+    }
+}
+
+#[cfg(target_arch = "aarch64")]
+mod imp {
+    use super::asm;
+
+    #[inline(always)]
+    pub unsafe fn syscall0(n: usize) -> usize {
+        let ret;
+        unsafe { asm!("svc #0", in("x8") n, lateout("x0") ret, options(nostack)) };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall1(n: usize, a: usize) -> usize {
+        let ret;
+        unsafe { asm!("svc #0", in("x8") n, inlateout("x0") a => ret, options(nostack)) };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall2(n: usize, a: usize, b: usize) -> usize {
+        let ret;
+        unsafe {
+            asm!("svc #0", in("x8") n, inlateout("x0") a => ret, in("x1") b, options(nostack))
+        };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall3(n: usize, a: usize, b: usize, c: usize) -> usize {
+        let ret;
+        unsafe {
+            asm!("svc #0", in("x8") n, inlateout("x0") a => ret, in("x1") b, in("x2") c,
+                options(nostack))
+        };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall4(n: usize, a: usize, b: usize, c: usize, d: usize) -> usize {
+        let ret;
+        unsafe {
+            asm!("svc #0", in("x8") n, inlateout("x0") a => ret, in("x1") b, in("x2") c,
+                in("x3") d, options(nostack))
+        };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall5(n: usize, a: usize, b: usize, c: usize, d: usize, e: usize) -> usize {
+        let ret;
+        unsafe {
+            asm!("svc #0", in("x8") n, inlateout("x0") a => ret, in("x1") b, in("x2") c,
+                in("x3") d, in("x4") e, options(nostack))
+        };
+        ret
+    }
+    #[inline(always)]
+    pub unsafe fn syscall6(
+        n: usize,
+        a: usize,
+        b: usize,
+        c: usize,
+        d: usize,
+        e: usize,
+        f: usize,
+    ) -> usize {
+        let ret;
+        unsafe {
+            asm!("svc #0", in("x8") n, inlateout("x0") a => ret, in("x1") b, in("x2") c,
+                in("x3") d, in("x4") e, in("x5") f, options(nostack))
+        };
+        ret
+    }
+}
+
+pub use imp::*;
