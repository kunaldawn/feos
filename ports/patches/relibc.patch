+    unsafe fn spawn(
+        program: CStr,
+        fac: Option<&crate::header::spawn::posix_spawn_file_actions_t>,
+        fat: Option<&crate::header::spawn::posix_spawnattr_t>,
+        argv: NulTerminated<*mut c_char>,
+        envp: Option<NulTerminated<*mut c_char>>,
+    ) -> Result<pid_t> {
+        use crate::header::spawn::Action;
+
+        let args = unsafe { user_strs(argv) };
+        let envs = match envp {
+            Some(envp) => unsafe { user_strs(envp) },
+            None => {
+                let environ: Vec<*mut c_char> = super::environ_iter().collect();
+                unsafe { user_strs(environ.iter()) }
+            }
+        };
+
+        // The file actions, in order. `paths` keeps the strings their PathAts point at.
+        let mut actions = Vec::new();
+        let mut paths: Vec<alloc::ffi::CString> = Vec::new();
+        if let Some(fac) = fac {
+            for action in fac {
+                let mut a = abi::SpawnAction::default();
+                match action {
+                    Action::Open {
+                        fd,
+                        path,
+                        flag,
+                        mode,
+                    } => {
+                        a.kind = abi::spawn_action::OPEN;
+                        a.fd = fd;
+                        a.open_flags = flag as u32;
+                        a.mode = mode as u32;
+                        a.path = path_at(AT_FDCWD, CStr::borrow(&path));
+                        paths.push(path);
+                    }
+                    Action::Close(fd) => {
+                        a.kind = abi::spawn_action::CLOSE;
+                        a.fd = fd;
+                    }
+                    Action::Chdir(path) => {
+                        a.kind = abi::spawn_action::CHDIR;
+                        a.path = path_at(AT_FDCWD, CStr::borrow(&path));
+                        paths.push(path);
+                    }
+                    Action::FChdir(fd) => {
+                        a.kind = abi::spawn_action::FCHDIR;
+                        a.fd = fd;
+                    }
+                    Action::Dup2(from, to) => {
+                        a.kind = abi::spawn_action::DUP2;
+                        a.fd = from;
+                        a.to = to;
+                    }
+                    Action::CloseFrom(fd) => {
+                        a.kind = abi::spawn_action::CLOSEFROM;
+                        a.fd = fd;
+                    }
+                    Action::TcSetPgrp(fd) => {
+                        a.kind = abi::spawn_action::TCSETPGRP;
+                        a.fd = fd;
+                    }
+                }
+                actions.push(a);
+            }
+        }
+
+        let mut request = abi::SpawnRequest {
+            path: path_at(AT_FDCWD, program),
+            argv: args.as_ptr() as u64,
+            argc: args.len() as u64,
+            envp: envs.as_ptr() as u64,
+            envc: envs.len() as u64,
+            actions: actions.as_ptr() as u64,
+            action_count: actions.len() as u64,
+            ..Default::default()
+        };
+        if let Some(attr) = fat {
+            // The feos spawn.h uses glibc's bit values, which SPAWN2 takes as they are.
+            // SPAWN2 wants the fields a flag doesn't ask for zero (EINVAL otherwise), and
+            // POSIX ignores an attribute whose flag isn't set.
+            let flags = attr.flags as u16 as u64;
+            request.flags = flags;
+            if flags & abi::spawn::SETPGROUP != 0 {
+                request.pgroup = attr.pgroup as i64;
+            }
+            if flags & abi::spawn::SETSIGMASK != 0 {
+                request.sigmask = attr.sigmask;
+            }
+            if flags & abi::spawn::SETSIGDEF != 0 {
+                request.sigdefault = attr.sigdefault;
+            }
+        }
+        let result = e_raw(unsafe {
+            syscall1(nr::SPAWN2, (&raw const request) as usize)
+        });
+        drop(paths);
+        result.map(|pid| pid as pid_t)
+    }
+
+    fn symlinkat(path1: CStr, fd: c_int, path2: CStr) -> Result<()> {
+        let (t, tlen) = path(path1);
+        let (p, len) = path(path2);
+        e_raw(unsafe { syscall5(nr::SYMLINKAT, t, tlen, int(fd), p, len) }).map(|_| ())
+    }
+
+    fn sync() -> Result<()> {
+        e_raw(unsafe { syscall0(nr::SYNC) }).map(|_| ())
+    }
+
+    fn timer_create(_clock_id: clockid_t, _evp: &sigevent) -> Result<timer_t> {
+        // No POSIX timers (section 9.1).
+        Err(Errno(ENOSYS))
+    }
+
+    fn timer_delete(_timerid: timer_t) -> Result<()> {
+        Err(Errno(ENOSYS))
+    }
+
+    fn timer_gettime(_timerid: timer_t) -> Result<itimerspec> {
+        Err(Errno(ENOSYS))
+    }
+
+    fn timer_settime(
+        _timerid: timer_t,
+        _flags: c_int,
+        _value: &itimerspec,
+        _ovalue: Option<Out<itimerspec>>,
+    ) -> Result<()> {
+        Err(Errno(ENOSYS))
+    }
+
+    fn umask(mask: mode_t) -> mode_t {
+        unsafe { syscall1(nr::UMASK, (mask & 0o777) as usize) as mode_t }
+    }
+
+    fn uname(mut utsname: Out<utsname>) -> Result<()> {
+        let info = sysinfo()?;
+        let mut u: utsname = unsafe { mem::zeroed() };
+        fn put(field: &mut [c_char; UTSLENGTH], bytes: &[u8]) {
+            let bytes = &bytes[..bytes.iter().position(|&b| b == 0).unwrap_or(bytes.len())];
+            let n = bytes.len().min(UTSLENGTH - 1);
+            for (dst, &src) in field.iter_mut().zip(&bytes[..n]) {
+                *dst = src as c_char;
+            }
+        }
+        put(&mut u.sysname, b"feos");
+        // The node name is /etc/hostname's first line, or "feos".
+        let mut host = [0u8; UTSLENGTH];
+        let mut host_len = 0;
+        if let Ok(fd) = Self::open(c"/etc/hostname".into(), abi::o::RDONLY | O_CLOEXEC, 0) {
+            host_len = Self::read(fd, &mut host[..UTSLENGTH - 1]).unwrap_or(0);
+            let _ = Self::close(fd);
+        }
+        let host = &host[..host_len];
+        let host = &host[..host.iter().position(|&b| b == b'\n').unwrap_or(host.len())];
+        put(&mut u.nodename, if host.is_empty() { b"feos" } else { host });
+        put(&mut u.release, &info.release);
+        put(&mut u.version, &info.release);
+        put(&mut u.machine, &info.machine);
+        utsname.write(u);
+        Ok(())
+    }
+
+    fn unlinkat(fd: c_int, p: CStr, flags: c_int) -> Result<()> {
+        let (p, len) = path(p);
+        e_raw(unsafe { syscall4(nr::UNLINKAT, int(fd), p, len, int(flags)) }).map(|_| ())
+    }
+
+    fn waitpid(pid: pid_t, stat_loc: Option<Out<c_int>>, options: c_int) -> Result<pid_t> {
+        let mut status: c_int = 0;
+        match e_raw(unsafe {
+            syscall4(nr::WAIT4, int(pid), (&raw mut status) as usize, int(options), 0)
+        }) {
+            Ok(child) => {
+                if let Some(mut out) = stat_loc {
+                    out.write(status);
+                }
+                Ok(child as pid_t)
+            }
+            // Before WAIT4 (stage 1c.8), v1's WAIT is what the kernel offers: one child
+            // by pid, blocking. Nothing stops before 1c.8, so WUNTRACED and WCONTINUED
+            // change nothing; WNOHANG and the group forms can't be had from it.
+            Err(Errno(ENOSYS))
+                if pid > 0 && options & !(abi::wait::UNTRACED | abi::wait::CONTINUED) == 0 =>
+            {
+                let status = Self::wait_v1(pid)?;
+                if let Some(mut out) = stat_loc {
+                    out.write(status);
+                }
+                Ok(pid)
+            }
+            Err(e) => Err(e),
+        }
+    }
+
+    fn write(fildes: c_int, buf: &[u8]) -> Result<usize> {
+        e_raw(unsafe { syscall3(nr::WRITE, int(fildes), buf.as_ptr() as usize, buf.len()) })
+    }
+
+    fn pwrite(fildes: c_int, buf: &[u8], off: off_t) -> Result<usize> {
+        e_raw(unsafe {
+            syscall4(
+                nr::PWRITE,
+                int(fildes),
+                buf.as_ptr() as usize,
+                buf.len(),
+                off as usize,
+            )
+        })
+    }
+
+    unsafe fn writev(fildes: c_int, iov: *const iovec, iovcnt: c_int) -> Result<usize> {
+        // Gathered into one buffer of up to 64 KiB and written with one WRITE, so a
+        // writev to a pipe of up to PIPE_BUF stays atomic; larger ones buffer by buffer.
+        const GATHER_MAX: usize = 64 * 1024;
+        if iovcnt < 0 {
+            return Err(Errno(EINVAL));
+        }
+        let iovs = unsafe { core::slice::from_raw_parts(iov, iovcnt as usize) };
+        let total: usize = iovs.iter().map(|v| v.iov_len).sum();
+        if total <= GATHER_MAX {
+            let mut buf = Vec::new();
+            buf.try_reserve_exact(total).map_err(|_| Errno(ENOMEM))?;
+            for v in iovs {
+                buf.extend_from_slice(unsafe {
+                    core::slice::from_raw_parts(v.iov_base.cast::<u8>(), v.iov_len)
+                });
+            }
+            return Self::write(fildes, &buf);
+        }
+        let mut written = 0usize;
+        for v in iovs {
+            if v.iov_len == 0 {
+                continue;
+            }
+            let buf = unsafe { core::slice::from_raw_parts(v.iov_base.cast::<u8>(), v.iov_len) };
+            match Self::write(fildes, buf) {
+                Ok(n) => {
+                    written += n;
+                    if n < v.iov_len {
+                        break;
+                    }
+                }
+                Err(e) if written == 0 => return Err(e),
+                Err(_) => break,
+            }
+        }
+        Ok(written)
+    }
+
+    fn verify() -> bool {
+        // SYSINFO: an ABI v2 kernel with every stage relibc was built for (section 1).
+        match sysinfo() {
+            Ok(info) => {
+                info.abi_version >= abi::ABI_VERSION
+                    && info.features & abi::FEATURES_REQUIRED == abi::FEATURES_REQUIRED
+            }
+            Err(_) => false,
+        }
+    }
+}
+
+/// The one id `setres*id` may set: all three the same, or `-1` to leave one.
+fn one_id(ids: [c_int; 3]) -> Result<Option<c_int>> {
+    let mut chosen = None;
+    for id in ids {
+        if id == -1 {
+            continue;
+        }
+        match chosen {
+            None => chosen = Some(id),
+            Some(c) if c == id => {}
+            Some(_) => return Err(Errno(EPERM)),
+        }
+    }
+    Ok(chosen)
+}
diff --git a/src/platform/feos/ptrace.rs b/src/platform/feos/ptrace.rs
new file mode 100644
index 0000000..70168f7
