+    fn posix_fallocate(fd: c_int, offset: u64, length: NonZeroU64) -> Result<()> {
+        // No preallocation: grow the file if the range ends past it, so ENOSPC comes
+        // at the write (section 9.1).
+        let end = offset.checked_add(length.get()).ok_or(Errno(EINVAL))?;
+        let mut st = mem::MaybeUninit::<stat>::uninit();
+        Self::fstat(fd, Out::from_uninit_mut(&mut st))?;
+        let size = unsafe { st.assume_init() }.st_size as u64;
+        if end > size {
+            Self::ftruncate(fd, end as off_t)?;
+        }
+        Ok(())
+    }
