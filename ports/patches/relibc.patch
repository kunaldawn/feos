+    fn poll(fds: &mut [pollfd], timeout: c_int) -> Result<c_int> {
+        // POLL takes nanoseconds, negative for forever.
+        let timeout_ns: i64 = if timeout < 0 {
+            -1
+        } else {
+            i64::from(timeout) * 1_000_000
+        };
+        e_raw(unsafe {
+            syscall4(
+                nr::POLL,
+                fds.as_mut_ptr() as usize,
+                fds.len(),
+                timeout_ns as usize,
+                0,
+            )
+        })
+        .map(|n| n as c_int)
+    }
+
+    fn ppoll(
+        fds: &mut [pollfd],
+        timeout: Option<&timespec>,
+        sigmask: Option<&sigset_t>,
+    ) -> Result<c_int> {
+        let timeout_ns: i64 = match timeout {
+            None => -1,
+            Some(t) => {
+                if t.tv_sec < 0 || !(0..1_000_000_000).contains(&t.tv_nsec) {
+                    return Err(Errno(EINVAL));
+                }
+                (t.tv_sec as i64)
+                    .saturating_mul(1_000_000_000)
+                    .saturating_add(t.tv_nsec as i64)
+            }
+        };
+        e_raw(unsafe {
+            syscall4(
+                nr::POLL,
+                fds.as_mut_ptr() as usize,
+                fds.len(),
+                timeout_ns as usize,
+                sigmask.map_or(0, |m| ptr::from_ref(m) as usize),
+            )
+        })
+        .map(|n| n as c_int)
+    }
