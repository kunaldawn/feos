+//! Build-time checks that relibc's own header values are the ones the feos kernel
+//! takes (section 5 of `docs/feos-abi-v2.md`): feos uses Linux's numbers, so relibc's
+//! Linux values pass through untranslated, and a mismatch here fails the build.
+
+use super::abi;
+use crate::header::{errno, fcntl, poll, sys_mman, sys_stat, sys_wait, time, unistd};
+
+macro_rules! same {
+    ($($a:expr => $b:expr),* $(,)?) => {
+        $(const _: () = assert!($a as i64 == $b as i64);)*
+    };
+}
+
+// Error numbers: feos's are Linux's, relibc's errno.h.
+same! {
+    errno::EPERM => abi::errno::EPERM,
+    errno::ENOENT => abi::errno::ENOENT,
+    errno::ESRCH => abi::errno::ESRCH,
+    errno::EINTR => abi::errno::EINTR,
+    errno::EIO => abi::errno::EIO,
+    errno::ENXIO => abi::errno::ENXIO,
+    errno::E2BIG => abi::errno::E2BIG,
+    errno::ENOEXEC => abi::errno::ENOEXEC,
+    errno::EBADF => abi::errno::EBADF,
+    errno::ECHILD => abi::errno::ECHILD,
+    errno::EAGAIN => abi::errno::EAGAIN,
+    errno::ENOMEM => abi::errno::ENOMEM,
+    errno::EACCES => abi::errno::EACCES,
+    errno::EFAULT => abi::errno::EFAULT,
+    errno::EBUSY => abi::errno::EBUSY,
+    errno::EEXIST => abi::errno::EEXIST,
+    errno::EXDEV => abi::errno::EXDEV,
+    errno::ENODEV => abi::errno::ENODEV,
+    errno::ENOTDIR => abi::errno::ENOTDIR,
+    errno::EISDIR => abi::errno::EISDIR,
+    errno::EINVAL => abi::errno::EINVAL,
+    errno::ENFILE => abi::errno::ENFILE,
+    errno::EMFILE => abi::errno::EMFILE,
+    errno::ENOTTY => abi::errno::ENOTTY,
+    errno::ETXTBSY => abi::errno::ETXTBSY,
+    errno::EFBIG => abi::errno::EFBIG,
+    errno::ENOSPC => abi::errno::ENOSPC,
+    errno::ESPIPE => abi::errno::ESPIPE,
+    errno::EROFS => abi::errno::EROFS,
+    errno::EMLINK => abi::errno::EMLINK,
+    errno::EPIPE => abi::errno::EPIPE,
+    errno::ERANGE => abi::errno::ERANGE,
+    errno::EDEADLK => abi::errno::EDEADLK,
+    errno::ENAMETOOLONG => abi::errno::ENAMETOOLONG,
+    errno::ENOLCK => abi::errno::ENOLCK,
+    errno::ENOSYS => abi::errno::ENOSYS,
+    errno::ENOTEMPTY => abi::errno::ENOTEMPTY,
+    errno::ELOOP => abi::errno::ELOOP,
+    errno::EOVERFLOW => abi::errno::EOVERFLOW,
+    errno::EILSEQ => abi::errno::EILSEQ,
+    errno::ENOTSOCK => abi::errno::ENOTSOCK,
+    errno::EDESTADDRREQ => abi::errno::EDESTADDRREQ,
+    errno::EMSGSIZE => abi::errno::EMSGSIZE,
+    errno::EPROTOTYPE => abi::errno::EPROTOTYPE,
+    errno::ENOPROTOOPT => abi::errno::ENOPROTOOPT,
+    errno::EPROTONOSUPPORT => abi::errno::EPROTONOSUPPORT,
+    errno::ESOCKTNOSUPPORT => abi::errno::ESOCKTNOSUPPORT,
+    errno::EOPNOTSUPP => abi::errno::EOPNOTSUPP,
+    errno::EAFNOSUPPORT => abi::errno::EAFNOSUPPORT,
+    errno::EADDRINUSE => abi::errno::EADDRINUSE,
+    errno::EADDRNOTAVAIL => abi::errno::EADDRNOTAVAIL,
+    errno::ENETDOWN => abi::errno::ENETDOWN,
+    errno::ENETUNREACH => abi::errno::ENETUNREACH,
+    errno::ECONNABORTED => abi::errno::ECONNABORTED,
+    errno::ECONNRESET => abi::errno::ECONNRESET,
+    errno::ENOBUFS => abi::errno::ENOBUFS,
+    errno::EISCONN => abi::errno::EISCONN,
+    errno::ENOTCONN => abi::errno::ENOTCONN,
+    errno::ETIMEDOUT => abi::errno::ETIMEDOUT,
+    errno::ECONNREFUSED => abi::errno::ECONNREFUSED,
+    errno::EHOSTUNREACH => abi::errno::EHOSTUNREACH,
+    errno::EALREADY => abi::errno::EALREADY,
+    errno::EINPROGRESS => abi::errno::EINPROGRESS,
+}
+
+// Files.
+same! {
+    fcntl::O_RDONLY => abi::o::RDONLY,
+    fcntl::O_WRONLY => abi::o::WRONLY,
+    fcntl::O_RDWR => abi::o::RDWR,
+    fcntl::O_ACCMODE => abi::o::ACCMODE,
+    fcntl::O_CREAT => abi::o::CREAT,
+    fcntl::O_EXCL => abi::o::EXCL,
+    fcntl::O_NOCTTY => abi::o::NOCTTY,
+    fcntl::O_TRUNC => abi::o::TRUNC,
+    fcntl::O_APPEND => abi::o::APPEND,
+    fcntl::O_NONBLOCK => abi::o::NONBLOCK,
+    fcntl::O_DIRECTORY => abi::o::DIRECTORY,
+    fcntl::O_NOFOLLOW => abi::o::NOFOLLOW,
+    fcntl::O_CLOEXEC => abi::o::CLOEXEC,
+    fcntl::O_PATH => abi::o::PATH,
+    fcntl::AT_FDCWD => abi::at::FDCWD,
+    fcntl::AT_SYMLINK_NOFOLLOW => abi::at::SYMLINK_NOFOLLOW,
+    fcntl::AT_REMOVEDIR => abi::at::REMOVEDIR,
+    fcntl::AT_EACCESS => abi::at::EACCESS,
+    fcntl::AT_SYMLINK_FOLLOW => abi::at::SYMLINK_FOLLOW,
+    fcntl::AT_EMPTY_PATH => abi::at::EMPTY_PATH,
+    fcntl::F_DUPFD => abi::f::DUPFD,
+    fcntl::F_GETFD => abi::f::GETFD,
+    fcntl::F_SETFD => abi::f::SETFD,
+    fcntl::F_GETFL => abi::f::GETFL,
+    fcntl::F_SETFL => abi::f::SETFL,
+    fcntl::F_GETLK => abi::f::GETLK,
+    fcntl::F_SETLK => abi::f::SETLK,
+    fcntl::F_SETLKW => abi::f::SETLKW,
+    fcntl::F_DUPFD_CLOEXEC => abi::f::DUPFD_CLOEXEC,
+    fcntl::FD_CLOEXEC => abi::f::FD_CLOEXEC,
+    sys_stat::S_IFMT => abi::s_if::MASK,
+    sys_stat::S_IFSOCK => abi::s_if::SOCK,
+    sys_stat::S_IFLNK => abi::s_if::LNK,
+    sys_stat::S_IFREG => abi::s_if::REG,
+    sys_stat::S_IFBLK => abi::s_if::BLK,
+    sys_stat::S_IFDIR => abi::s_if::DIR,
+    sys_stat::S_IFCHR => abi::s_if::CHR,
+    sys_stat::S_IFIFO => abi::s_if::FIFO,
+    unistd::SEEK_SET => abi::seek::SET,
+    unistd::SEEK_CUR => abi::seek::CURRENT,
+    unistd::SEEK_END => abi::seek::END,
+}
+
+// Memory, clocks, waiting.
+same! {
+    sys_mman::PROT_NONE => abi::prot::NONE,
+    sys_mman::PROT_READ => abi::prot::READ,
+    sys_mman::PROT_WRITE => abi::prot::WRITE,
+    sys_mman::PROT_EXEC => abi::prot::EXEC,
+    sys_mman::MAP_SHARED => abi::map::SHARED,
+    sys_mman::MAP_PRIVATE => abi::map::PRIVATE,
+    sys_mman::MAP_FIXED => abi::map::FIXED,
+    sys_mman::MAP_ANONYMOUS => abi::map::ANONYMOUS,
+    sys_mman::MAP_NORESERVE => abi::map::NORESERVE,
+    sys_mman::MAP_POPULATE => abi::map::POPULATE,
+    sys_mman::MAP_STACK => abi::map::STACK,
+    sys_mman::MAP_FIXED_NOREPLACE => abi::map::FIXED_NOREPLACE,
+    time::CLOCK_REALTIME => abi::clock::REALTIME,
+    time::CLOCK_MONOTONIC => abi::clock::MONOTONIC,
+    time::CLOCK_PROCESS_CPUTIME_ID => abi::clock::PROCESS_CPUTIME_ID,
+    time::CLOCK_THREAD_CPUTIME_ID => abi::clock::THREAD_CPUTIME_ID,
+    time::CLOCK_MONOTONIC_RAW => abi::clock::MONOTONIC_RAW,
+    time::CLOCK_REALTIME_COARSE => abi::clock::REALTIME_COARSE,
+    time::CLOCK_MONOTONIC_COARSE => abi::clock::MONOTONIC_COARSE,
+    time::CLOCK_BOOTTIME => abi::clock::BOOTTIME,
+    sys_wait::WNOHANG => abi::wait::NOHANG,
+    sys_wait::WUNTRACED => abi::wait::UNTRACED,
+    sys_wait::WCONTINUED => abi::wait::CONTINUED,
+    poll::POLLIN => 1,
+    poll::POLLOUT => 4,
+}
+
+// Structures passed through to the kernel unconverted.
+const _: () = {
+    use core::mem::{offset_of, size_of};
+    use crate::header::{bits_timespec::timespec, fcntl::flock, sys_resource::rusage, sys_statvfs::statvfs, dirent::dirent, bits_winsize::winsize, termios::termios};
+    assert!(size_of::<timespec>() == size_of::<abi::Timespec>());
+    assert!(size_of::<rusage>() == size_of::<abi::Rusage>());
+    assert!(size_of::<statvfs>() == size_of::<abi::StatVfs>());
+    assert!(size_of::<flock>() == size_of::<abi::Flock>());
+    assert!(offset_of!(flock, l_start) == offset_of!(abi::Flock, start));
+    assert!(offset_of!(flock, l_len) == offset_of!(abi::Flock, length));
+    assert!(offset_of!(flock, l_pid) == offset_of!(abi::Flock, pid));
+    assert!(offset_of!(dirent, d_off) == offset_of!(abi::Dirent, off));
+    assert!(offset_of!(dirent, d_reclen) == offset_of!(abi::Dirent, reclen));
+    assert!(offset_of!(dirent, d_type) == offset_of!(abi::Dirent, kind));
+    assert!(offset_of!(dirent, d_name) == abi::DIRENT_HEADER);
+    assert!(size_of::<winsize>() == size_of::<abi::WinSize>());
+    assert!(size_of::<termios>() == size_of::<abi::Termios>());
+};
