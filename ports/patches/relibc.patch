+    unsafe fn setrlimit(resource: c_int, rlim: *const rlimit) -> Result<()> {
+        // Accepted at or below the hard limit, without effect; EPERM above it.
+        let mut hard = mem::MaybeUninit::<rlimit>::uninit();
+        Self::getrlimit(resource, Out::from_uninit_mut(&mut hard))?;
+        let hard = unsafe { hard.assume_init() };
+        let new = unsafe { &*rlim };
+        if new.rlim_cur > new.rlim_max {
+            return Err(Errno(EINVAL));
+        }
+        if new.rlim_max > hard.rlim_max {
+            return Err(Errno(EPERM));
+        }
