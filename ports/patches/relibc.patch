diff --git a/src/header/signal/feos.rs b/src/header/signal/feos.rs
new file mode 100644
index 0000000..e114363
--- /dev/null
+++ b/src/header/signal/feos.rs
@@ -0,0 +1,175 @@
+//! feos's part of `signal.h`: the signal numbers and `SA_*` flags are Linux's
+//! (section 5.4 of feos's `docs/feos-abi-v2.md`), the contexts feos's own (section 8.4).
+
+use super::{sigset_t, stack_t};
+use crate::platform::types::{c_ulong, c_ulonglong};
+#[cfg(target_arch = "x86_64")]
+use crate::platform::types::{c_longlong, c_uchar, c_uint, c_ushort};
+#[cfg(target_arch = "aarch64")]
+use crate::platform::types::c_uint;
+use core::arch::global_asm;
+
+// The restorer a handler returns to: `SIGRETURN` (89) with the `UContext`'s address,
+// which is the stack pointer once the handler has returned (section 8.4).
+#[cfg(target_arch = "x86_64")]
+global_asm!(
+    "
+    .global __restore_rt
+    __restore_rt:
+        mov rdi, rsp
+        mov eax, 89
+        int 0xf0
+        ud2
+"
+);
+#[cfg(target_arch = "aarch64")]
+global_asm!(
+    "
+    .global __restore_rt
+    __restore_rt:
+        mov x0, sp
+        mov x8, #89
+        svc #0
+        brk #0
+"
+);
+
+/// Non-POSIX: a synonym for `SIGABRT`.
+pub const SIGIOT: usize = super::constants::SIGABRT;
+/// Obsolete in issue 7, removed in issue 8. Pollable event.
+pub const SIGPOLL: usize = super::constants::SIGIO;
+/// Non-POSIX: synonymous with `SIGSYS`.
+pub const SIGUNUSED: usize = super::constants::SIGSYS;
+
+/// Do not generate `SIGCHLD` when children stop or stopped children continue.
+pub const SA_NOCLDSTOP: usize = 1;
+/// Causes extra information to be passed to signal handlers.
+pub const SA_SIGINFO: usize = 4;
+/// Process is executing on an alternate signal stack.
+pub const SA_ONSTACK: usize = 0x0800_0000;
+/// Causes certain functions to become restartable.
+pub const SA_RESTART: usize = 0x1000_0000;
+/// Causes signal not to be automatically blocked on entry to signal handler.
+pub const SA_NODEFER: usize = 0x4000_0000;
+/// Causes signal dispositions to be set to `SIG_DFL` on entry to signal handlers.
+pub const SA_RESETHAND: usize = 0x8000_0000;
+/// Not for applications: `sa_restorer` holds the signal trampoline.
+pub const SA_RESTORER: usize = 0x0400_0000;
+
+pub(crate) type ucontext_t = ucontext;
+/// A machine-specific representation of the saved context.
+pub(crate) type mcontext_t = mcontext;
+
+/// The context a handler gets (section 8.4 of feos's ABI): 816 bytes on x86_64.
+#[cfg(target_arch = "x86_64")]
+#[repr(C)]
+pub struct ucontext {
+    /// `UC_FEOS_FXSAVE` (1): the FP area is an `FXSAVE64` image.
+    pub uc_flags: c_ulong,
+    /// Pointer to the context that is resumed when this context returns (always null).
+    pub uc_link: *mut ucontext_t,
+    /// The alternate stack as it was.
+    pub uc_stack: stack_t,
+    /// The set of signals that are blocked when this context is active.
+    pub uc_sigmask: sigset_t,
+    /// The registers.
+    pub uc_mcontext: mcontext_t,
+    /// The `FXSAVE64` image `uc_mcontext.fpregs` points at.
+    pub __fpregs_mem: [c_uchar; 512],
+}
+
+/// x86_64: the general registers in Linux's order (`r8`..`r15`, `rdi`, `rsi`, `rbp`,
+/// `rbx`, `rdx`, `rax`, `rcx`, `rsp`, `rip`, `rflags`, `cs_gs_fs`, `err`, `trapno`,
+/// `oldmask`, `cr2`), then a pointer to the FP state.
+#[cfg(target_arch = "x86_64")]
+#[repr(C)]
+pub struct mcontext {
+    pub gregs: [c_longlong; 23],
+    pub fpregs: *mut _libc_fpstate,
+    __reserved: [c_ulonglong; 8],
+}
+
+/// x86_64: the `FXSAVE64` image.
+#[cfg(target_arch = "x86_64")]
+#[repr(C)]
+pub struct _libc_fpstate {
+    pub cwd: c_ushort,
+    pub swd: c_ushort,
+    pub ftw: c_ushort,
+    pub fop: c_ushort,
+    pub rip: c_ulonglong,
+    pub rdp: c_ulonglong,
+    pub mxcsr: c_uint,
+    pub mxcr_mask: c_uint,
+    pub _st: [_libc_fpxreg; 8],
+    pub _xmm: [_libc_xmmreg; 16],
+    __private: [c_ulonglong; 12],
+}
+
+#[cfg(target_arch = "x86_64")]
+#[repr(C)]
+pub struct _libc_fpxreg {
+    pub significand: [c_ushort; 4],
+    pub exponent: c_ushort,
+    __private: [c_ushort; 3],
+}
+
+#[cfg(target_arch = "x86_64")]
+#[repr(C)]
+pub struct _libc_xmmreg {
+    pub element: [c_uint; 4],
+}
+
+/// The context a handler gets (section 8.4 of feos's ABI): 880 bytes on AArch64.
+#[cfg(target_arch = "aarch64")]
+#[repr(C)]
+pub struct ucontext {
+    /// 0.
+    pub uc_flags: c_ulong,
+    /// Always null.
+    pub uc_link: *mut ucontext_t,
+    /// The alternate stack as it was.
+    pub uc_stack: stack_t,
+    /// The set of signals that are blocked when this context is active.
+    pub uc_sigmask: sigset_t,
+    /// The registers.
+    pub uc_mcontext: mcontext_t,
+}
+
+/// AArch64: the fault address, `x0`..`x30`, `sp`, `pc`, `pstate`, `fpsr`, `fpcr`, then
+/// `q0`..`q31` as pairs of 64-bit halves (low first).
+#[cfg(target_arch = "aarch64")]
+#[repr(C)]
+pub struct mcontext {
+    pub fault_address: c_ulonglong,
+    pub regs: [c_ulonglong; 31],
+    pub sp: c_ulonglong,
+    pub pc: c_ulonglong,
+    pub pstate: c_ulonglong,
+    pub fpsr: c_uint,
+    pub fpcr: c_uint,
+    pub vregs: [c_ulonglong; 64],
+    __reserved: [c_ulonglong; 4],
+}
+
+#[cfg(target_arch = "x86_64")]
+const _: () = {
+    assert!(core::mem::size_of::<ucontext>() == 816);
+    assert!(core::mem::offset_of!(ucontext, uc_sigmask) == 40);
+    assert!(core::mem::offset_of!(ucontext, uc_mcontext) == 48);
+    assert!(core::mem::offset_of!(ucontext, __fpregs_mem) == 304);
+    assert!(core::mem::size_of::<_libc_fpstate>() == 512);
+};
+
+#[cfg(target_arch = "aarch64")]
+const _: () = {
+    assert!(core::mem::size_of::<ucontext>() == 880);
+    assert!(core::mem::offset_of!(ucontext, uc_sigmask) == 40);
+    assert!(core::mem::offset_of!(ucontext, uc_mcontext) == 48);
+    assert!(core::mem::offset_of!(mcontext, regs) == 8);
+    assert!(core::mem::offset_of!(mcontext, sp) == 256);
+    assert!(core::mem::offset_of!(mcontext, pc) == 264);
+    assert!(core::mem::offset_of!(mcontext, pstate) == 272);
+    assert!(core::mem::offset_of!(mcontext, fpsr) == 280);
+    assert!(core::mem::offset_of!(mcontext, vregs) == 288);
+};
