@@ -0,0 +1,23 @@
+//! No `ptrace` on feos (section 9.4 of `docs/feos-abi-v2.md`): no debugger is on the
+//! toolchain's path yet.
+
+use super::Sys;
+use crate::{
+    error::{Errno, Result},
+    header::errno::ENOSYS,
+    platform::{
+        PalPtrace,
+        types::{c_int, c_void, pid_t},
+    },
+};
+
+impl PalPtrace for Sys {
+    unsafe fn ptrace(
+        _request: c_int,
+        _pid: pid_t,
+        _addr: *mut c_void,
+        _data: *mut c_void,
+    ) -> Result<c_int> {
+        Err(Errno(ENOSYS))
+    }
+}
diff --git a/src/platform/feos/signal.rs b/src/platform/feos/signal.rs
new file mode 100644
index 0000000..7888dd7
--- /dev/null
+++ b/src/platform/feos/signal.rs
@@ -0,0 +1,140 @@
+//! `PalSignal` for feos (section 9.2 of `docs/feos-abi-v2.md`). The signal calls arrive
+//! with kernel stages 1c.8 to 1c.10; until then they return the kernel's `ENOSYS`.
+
+use core::ptr;
+
+use super::{
+    super::{
+        PalSignal,
+        types::{c_int, pid_t},
+    },
+    Sys, abi, e_raw, int,
+    syscall::*,
+};
+#[expect(deprecated)]
+use crate::header::sys_time::itimerval;
+use crate::{
+    error::{Errno, Result},
+    header::{
+        bits_sigset_t::sigset_t,
+        bits_timespec::timespec,
+        errno::ENOSYS,
+        signal::{SA_RESTORER, sigaction, siginfo_t, sigval, stack_t},
+    },
+};
+
+use abi::nr;
+
+impl PalSignal for Sys {
+    #[expect(deprecated)]
+    fn getitimer(which: c_int, out: &mut itimerval) -> Result<()> {
+        // relibc's itimerval is Linux's, which is abi::ITimerVal.
+        e_raw(unsafe { syscall3(nr::SETITIMER, int(which), 0, ptr::from_mut(out) as usize) })
+            .map(|_| ())
+    }
+
+    fn kill(pid: pid_t, sig: c_int) -> Result<()> {
+        e_raw(unsafe { syscall2(nr::KILL, int(pid), int(sig)) }).map(|_| ())
+    }
+
+    fn sigqueue(pid: pid_t, sig: c_int, _val: sigval) -> Result<()> {
+        // The value is dropped: KILL, with SI_USER.
+        Self::kill(pid, sig)
+    }
+
+    fn killpg(pgrp: pid_t, sig: c_int) -> Result<()> {
+        Self::kill(pgrp.wrapping_neg(), sig)
+    }
+
+    fn raise(sig: c_int) -> Result<()> {
+        Self::thread_kill(unsafe { syscall0(nr::GETTID) }, sig)
+    }
+
+    #[expect(deprecated)]
+    fn setitimer(which: c_int, new: &itimerval, old: Option<&mut itimerval>) -> Result<()> {
+        e_raw(unsafe {
+            syscall3(
+                nr::SETITIMER,
+                int(which),
+                ptr::from_ref(new) as usize,
+                old.map_or(0, |o| ptr::from_mut(o) as usize),
+            )
+        })
+        .map(|_| ())
+    }
+
+    fn sigaction(sig: c_int, act: Option<&sigaction>, oact: Option<&mut sigaction>) -> Result<()> {
+        unsafe extern "C" {
+            fn __restore_rt();
+        }
+        // A fresh SigAction: sa_flags is a c_int, so SA_RESETHAND is negative there and
+        // must not be sign-extended into the kernel's word.
+        let new = act.map(|act| abi::SigAction {
+            handler: act.sa_handler.map_or(0, |f| f as usize as u64),
+            flags: (act.sa_flags as u32) | SA_RESTORER as u32,
+            reserved: 0,
+            restorer: __restore_rt as *const () as usize as u64,
+            mask: act.sa_mask,
+        });
+        let mut old = abi::SigAction::default();
+        e_raw(unsafe {
+            syscall3(
+                nr::SIGACTION,
+                int(sig),
+                new.as_ref().map_or(0, |n| ptr::from_ref(n) as usize),
+                if oact.is_some() { (&raw mut old) as usize } else { 0 },
+            )
+        })?;
+        if let Some(oact) = oact {
+            oact.sa_handler = unsafe { core::mem::transmute::<usize, Option<extern "C" fn(c_int)>>(old.handler as usize) };
+            oact.sa_flags = old.flags as c_int;
+            oact.sa_restorer = unsafe { core::mem::transmute::<usize, Option<unsafe extern "C" fn()>>(old.restorer as usize) };
+            oact.sa_mask = old.mask;
+        }
+        Ok(())
+    }
+
+    unsafe fn sigaltstack(ss: Option<&stack_t>, old_ss: Option<&mut stack_t>) -> Result<()> {
+        // relibc's stack_t is Linux's, which is abi::SigStack.
+        e_raw(unsafe {
+            syscall2(
+                nr::SIGALTSTACK,
+                ss.map_or(0, |s| ptr::from_ref(s) as usize),
+                old_ss.map_or(0, |s| ptr::from_mut(s) as usize),
+            )
+        })
+        .map(|_| ())
+    }
+
+    fn sigpending(set: &mut sigset_t) -> Result<()> {
+        e_raw(unsafe { syscall1(nr::SIGPENDING, ptr::from_mut(set) as usize) }).map(|_| ())
+    }
+
+    fn sigprocmask(how: c_int, set: Option<&sigset_t>, oset: Option<&mut sigset_t>) -> Result<()> {
+        e_raw(unsafe {
+            syscall3(
+                nr::SIGPROCMASK,
+                int(how),
+                set.map_or(0, |s| ptr::from_ref(s) as usize),
+                oset.map_or(0, |s| ptr::from_mut(s) as usize),
+            )
+        })
+        .map(|_| ())
+    }
+
+    fn sigsuspend(mask: &sigset_t) -> Errno {
+        match e_raw(unsafe { syscall1(nr::SIGSUSPEND, ptr::from_ref(mask) as usize) }) {
+            Err(e) => e,
+            Ok(_) => unreachable!("SIGSUSPEND always fails"),
+        }
+    }
+
+    fn sigtimedwait(
+        _set: &sigset_t,
+        _sig: Option<&mut siginfo_t>,
+        _tp: Option<&timespec>,
+    ) -> Result<c_int> {
+        // No call for it (section 9.2).
+        Err(Errno(ENOSYS))
+    }
+}
diff --git a/src/platform/feos/socket.rs b/src/platform/feos/socket.rs
new file mode 100644
index 0000000..3bb7914
--- /dev/null
+++ b/src/platform/feos/socket.rs
@@ -0,0 +1,248 @@
+//! `PalSocket` for feos (section 9.3 of `docs/feos-abi-v2.md`), at the call numbers of
+//! section 3.7. The sockets arrive with kernel stages 1e.3 and 1e.4; until then the
+//! calls return the kernel's `ENOSYS`.
+
+use alloc::vec::Vec;
+use core::ptr;
+
+use super::{Sys, abi, e_raw, int, syscall::*};
+use crate::{
+    error::{Errno, Result},
+    header::{
+        errno::{EINVAL, ENOMEM, EOPNOTSUPP},
+        sys_socket::{msghdr, socklen_t},
+    },
+    out::Out,
+    platform::{PalSocket, types::c_int},
+};
+
+use abi::nr;
+
+impl PalSocket for Sys {
+    fn accept(socket: c_int, address_dst: Option<&mut [u8]>) -> Result<(c_int, socklen_t)> {
+        let mut len = address_dst.as_ref().map_or(0, |a| a.len()) as socklen_t;
+        let address = address_dst.map_or(0, |a| a.as_mut_ptr() as usize);
+        let fd = e_raw(unsafe {
+            syscall4(
+                nr::ACCEPT,
+                int(socket),
+                address,
+                if address == 0 { 0 } else { (&raw mut len) as usize },
+                0,
+            )
+        })? as c_int;
+        Ok((fd, len))
+    }
+
+    fn bind(socket: c_int, address_raw: &[u8]) -> Result<()> {
+        e_raw(unsafe {
+            syscall3(nr::BIND, int(socket), address_raw.as_ptr() as usize, address_raw.len())
+        })
+        .map(|_| ())
+    }
+
+    fn connect(socket: c_int, address_raw: &[u8]) -> Result<c_int> {
+        e_raw(unsafe {
+            syscall3(nr::CONNECT, int(socket), address_raw.as_ptr() as usize, address_raw.len())
+        })
+        .map(|v| v as c_int)
+    }
+
+    fn getpeername(socket: c_int, address_dst: &mut [u8]) -> Result<socklen_t> {
+        let mut len = address_dst.len() as socklen_t;
+        e_raw(unsafe {
+            syscall3(
+                nr::GETPEERNAME,
+                int(socket),
+                address_dst.as_mut_ptr() as usize,
+                (&raw mut len) as usize,
+            )
+        })?;
+        Ok(len)
+    }
+
+    fn getsockname(socket: c_int, address_dst: &mut [u8]) -> Result<socklen_t> {
+        let mut len = address_dst.len() as socklen_t;
+        e_raw(unsafe {
+            syscall3(
+                nr::GETSOCKNAME,
+                int(socket),
+                address_dst.as_mut_ptr() as usize,
+                (&raw mut len) as usize,
+            )
+        })?;
+        Ok(len)
+    }
+
+    fn getsockopt(
+        socket: c_int,
+        level: c_int,
+        option_name: c_int,
+        option_value: &mut [u8],
+    ) -> Result<socklen_t> {
+        let mut len = option_value.len() as socklen_t;
+        e_raw(unsafe {
+            syscall5(
+                nr::GETSOCKOPT,
+                int(socket),
+                int(level),
+                int(option_name),
+                option_value.as_mut_ptr() as usize,
+                (&raw mut len) as usize,
+            )
+        })?;
+        Ok(len)
+    }
+
+    fn listen(socket: c_int, backlog: c_int) -> Result<()> {
+        e_raw(unsafe { syscall2(nr::LISTEN, int(socket), int(backlog)) }).map(|_| ())
+    }
+
+    fn recvfrom(
+        socket: c_int,
+        mut buf: Out<[u8]>,
+        flags: c_int,
+        address_raw: Option<&mut [u8]>,
+    ) -> Result<(usize, socklen_t)> {
+        let mut len = address_raw.as_ref().map_or(0, |a| a.len()) as socklen_t;
+        let address = address_raw.map_or(0, |a| a.as_mut_ptr() as usize);
+        let count = e_raw(unsafe {
+            syscall6(
+                nr::RECVFROM,
+                int(socket),
+                buf.as_mut_ptr().as_mut_ptr() as usize,
+                buf.len(),
+                int(flags),
+                address,
+                if address == 0 { 0 } else { (&raw mut len) as usize },
+            )
+        })?;
+        Ok((count, len))
+    }
+
+    unsafe fn recvmsg(socket: c_int, msg: *mut msghdr, flags: c_int) -> Result<usize> {
+        // RECVFROM into one buffer, scattered into the iovecs; no control data.
+        let msg = unsafe { &mut *msg };
+        let iovs = unsafe { core::slice::from_raw_parts(msg.msg_iov, msg.msg_iovlen) };
+        let total: usize = iovs.iter().map(|v| v.iov_len).sum();
+        let mut buf = Vec::new();
+        buf.try_reserve_exact(total).map_err(|_| Errno(ENOMEM))?;
+        buf.resize(total, 0u8);
+        let mut name_len = msg.msg_namelen;
+        let count = e_raw(unsafe {
+            syscall6(
+                nr::RECVFROM,
+                int(socket),
+                buf.as_mut_ptr() as usize,
+                total,
+                int(flags),
+                msg.msg_name as usize,
+                if msg.msg_name.is_null() { 0 } else { (&raw mut name_len) as usize },
+            )
+        })?;
+        let mut at = 0;
+        for v in iovs {
+            let n = v.iov_len.min(count - at);
+            unsafe { ptr::copy_nonoverlapping(buf.as_ptr().add(at), v.iov_base.cast::<u8>(), n) };
+            at += n;
+            if at == count {
+                break;
+            }
+        }
+        if !msg.msg_name.is_null() {
+            msg.msg_namelen = name_len;
+        }
+        msg.msg_controllen = 0;
+        // RECVFROM returns at most the buffer's length and drops the rest of a longer
+        // datagram (section 3.7), with no way to ask for its full length, so a
+        // truncation can't be told from a datagram that fit: MSG_TRUNC isn't reported.
+        msg.msg_flags = 0;
+        Ok(count)
+    }
+
+    unsafe fn sendmsg(socket: c_int, msg: *const msghdr, flags: c_int) -> Result<usize> {
+        // The iovecs gathered into one SENDTO; control data isn't supported.
+        let msg = unsafe { &*msg };
+        if msg.msg_controllen != 0 {
+            return Err(Errno(EOPNOTSUPP));
+        }
+        if msg.msg_iovlen > 0 && msg.msg_iov.is_null() {
+            return Err(Errno(EINVAL));
+        }
+        let iovs = unsafe { core::slice::from_raw_parts(msg.msg_iov, msg.msg_iovlen) };
+        let total: usize = iovs.iter().map(|v| v.iov_len).sum();
+        let mut buf = Vec::new();
+        buf.try_reserve_exact(total).map_err(|_| Errno(ENOMEM))?;
+        for v in iovs {
+            buf.extend_from_slice(unsafe {
+                core::slice::from_raw_parts(v.iov_base.cast::<u8>(), v.iov_len)
+            });
+        }
+        e_raw(unsafe {
+            syscall6(
+                nr::SENDTO,
+                int(socket),
+                buf.as_ptr() as usize,
+                buf.len(),
+                int(flags),
+                msg.msg_name as usize,
+                msg.msg_namelen as usize,
+            )
+        })
+    }
+
+    fn sendto(socket: c_int, buf: &[u8], flags: c_int, dest: Option<&[u8]>) -> Result<usize> {
+        e_raw(unsafe {
+            syscall6(
+                nr::SENDTO,
+                int(socket),
+                buf.as_ptr() as usize,
+                buf.len(),
+                int(flags),
+                dest.map_or(0, |d| d.as_ptr() as usize),
+                dest.map_or(0, <[u8]>::len),
+            )
+        })
+    }
+
+    fn setsockopt(
+        socket: c_int,
+        level: c_int,
+        option_name: c_int,
+        option_value: &[u8],
+    ) -> Result<()> {
+        e_raw(unsafe {
+            syscall5(
+                nr::SETSOCKOPT,
+                int(socket),
+                int(level),
+                int(option_name),
+                option_value.as_ptr() as usize,
+                option_value.len(),
+            )
+        })
+        .map(|_| ())
+    }
+
+    fn shutdown(socket: c_int, how: c_int) -> Result<()> {
+        e_raw(unsafe { syscall2(nr::SHUTDOWN, int(socket), int(how)) }).map(|_| ())
+    }
+
+    fn socket(domain: c_int, kind: c_int, protocol: c_int) -> Result<c_int> {
+        e_raw(unsafe { syscall3(nr::SOCKET, int(domain), int(kind), int(protocol)) })
+            .map(|fd| fd as c_int)
+    }
+
+    fn socketpair(domain: c_int, kind: c_int, protocol: c_int, sv: &mut [c_int; 2]) -> Result<()> {
+        e_raw(unsafe {
+            syscall4(
+                nr::SOCKETPAIR,
+                int(domain),
+                int(kind),
+                int(protocol),
+                sv.as_mut_ptr() as usize,
+            )
+        })
+        .map(|_| ())
+    }
+}
