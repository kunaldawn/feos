+    unsafe fn rlct_clone(
+        stack: *mut usize,
+        _os_specific: &mut OsSpecific,
+    ) -> Result<crate::pthread::OsTid> {
+        // `stack` points at relibc's start words; THREAD_CREATE wants a 16-byte
+        // aligned stack top, which below the words is (they're popped first).
+        let words = stack as usize;
+        let tid = e_raw(unsafe {
+            syscall5(
+                nr::THREAD_CREATE,
+                __relibc_feos_thread_start as *const () as usize,
+                words & !15,
+                0,
+                words,
+                0,
+            )
+        })?;
+        Ok(crate::pthread::OsTid { thread_id: tid })
+    }
