# CMake toolchain file for aarch64-unknown-feos (track T5): the feos clang from
# ports/build-clang.sh, by default in /build/llvm-feos (FEOS_LLVM), and its sysroot
# (FEOS_SYSROOT, else the toolchain's own <triple> directory, clang's default).
#   cmake -DCMAKE_TOOLCHAIN_FILE=ports/cmake/aarch64-unknown-feos.cmake ...
set(CMAKE_SYSTEM_NAME Feos)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
if(DEFINED ENV{FEOS_LLVM})
  set(_feos_llvm "$ENV{FEOS_LLVM}")
else()
  set(_feos_llvm /build/llvm-feos)
endif()
set(CMAKE_C_COMPILER "${_feos_llvm}/bin/clang")
set(CMAKE_CXX_COMPILER "${_feos_llvm}/bin/clang++")
set(CMAKE_ASM_COMPILER "${_feos_llvm}/bin/clang")
set(CMAKE_C_COMPILER_TARGET aarch64-unknown-feos)
set(CMAKE_CXX_COMPILER_TARGET aarch64-unknown-feos)
set(CMAKE_ASM_COMPILER_TARGET aarch64-unknown-feos)
set(CMAKE_AR "${_feos_llvm}/bin/llvm-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${_feos_llvm}/bin/llvm-ranlib" CACHE FILEPATH "")
set(CMAKE_NM "${_feos_llvm}/bin/llvm-nm" CACHE FILEPATH "")
set(CMAKE_OBJCOPY "${_feos_llvm}/bin/llvm-objcopy" CACHE FILEPATH "")
set(CMAKE_STRIP "${_feos_llvm}/bin/llvm-strip" CACHE FILEPATH "")
if(DEFINED ENV{FEOS_SYSROOT})
  set(CMAKE_SYSROOT "$ENV{FEOS_SYSROOT}")
else()
  set(CMAKE_SYSROOT "${_feos_llvm}/aarch64-unknown-feos")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
